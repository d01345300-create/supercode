                parsed.append((d.get("title") or f"Сессия {d.get('id', '')[-6:]}", d.get("id", ""), str(sp)))
            except Exception:
                pass
        query, sel = "", 0
        while True:
            items = [p for p in parsed if query.lower() in f"{p} {p}".lower()]
            if not items:
                items = [("Нет сохранённых сессий", "", None)]
            sel = max(0, min(sel, len(items) - 1))

            self.draw()
            my, mx = self.stdscr.getmaxyx()
