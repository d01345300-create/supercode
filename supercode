def shrink_text(text, max_chars=900):
    lines = text.splitlines()
    if len(text) <= max_chars and len(lines) <= 22:
        return text
    if len(lines) > 22:
        res = "\n".join(lines[:10]) + f"\n... [сжато {len(lines)-18} строк] ...\n" + "\n".join(lines[-8:])
        return res[:max_chars] + ("\n...[обрезано]" if len(res) > max_chars else "")
    return text[:max_chars // 2] + "\n... [сжато] ...\n" + text[-(max_chars // 2):]

def web_search_ddg(query, limit=5):
    import html as _html
    from html.parser import HTMLParser
    class _DDG(HTMLParser):
        def __init__(self):
            super().__init__()
            self.links, self.snips, self.cur_href, self.in_a, self.in_sn, self.buf = [], [], "", False, False, []
        def handle_starttag(self, tag, attrs):
            d = dict(attrs)
            if tag == "a" and d.get("href"):
                self.cur_href, self.in_a, self.buf = d["href"], True, []
            elif tag == "td" and "result-snippet" in d.get("class", ""):
                self.in_sn, self.buf = True, []
        def handle_data(self, data):
            if self.in_a or self.in_sn: self.buf.append(data)
        def handle_endtag(self, tag):
            if tag == "a" and self.in_a:
                self.links.append((self.cur_href, "".join(self.buf).strip()))
                self.in_a = False
            elif tag == "td" and self.in_sn:
                self.snips.append(" ".join("".join(self.buf).split()))
                self.in_sn = False
    host = "html." + "duckduckgo." + "com"
    u = "https://" + host + "/lite/?" + urllib.parse.urlencode({"q": query, "kl": "ru-ru"})
    hdr = {"User-Agent": "Mozilla/5.0 (X11; Linux x86_64) Gecko/20100101 Firefox/131.0"}
    try:
        page = urllib.request.urlopen(urllib.request.Request(u, headers=hdr), timeout=12).read().decode("utf-8", errors="ignore")
        pr = _DDG()
        pr.feed(page)
        out = []
        for raw_href, title in pr.links:
            href = _html.unescape(raw_href)
            if "uddg=" in href:
                href = urllib.parse.parse_qs(urllib.parse.urlparse(href).query).get("uddg", [href])[0]
            elif href.startswith("//"):
                href = "https:" + href
            if not href.startswith("http") or "duckduckgo.com" in href or is_media_url(href) or not title: continue
            sn = pr.snips[len(out)] if len(out) < len(pr.snips) else ""
            out.append(f"{len(out)+1}. {title}\n   URL: {href}\n   {sn}")
            if len(out) >= limit: break
        return "\n\n".join(out) if out else f"Нет совпадений (HTML {len(page)} байт)."
    except Exception as e:
        return f"Ошибка поиска: {e}"

MEDIA_EXT_RE = re.compile(r"\.(mp4|avi|mkv|webm|mov|mp3|wav|ogg|flac|aac|m4a|jpg|jpeg|png|gif|webp|svg|bmp|ico|pdf|zip|rar|7z|exe|apk)(\?|$)", re.I)
MEDIA_DOM_RE = re.compile(r"(youtube\.com|youtu\.be|rutube\.ru|tiktok\.com|vimeo\.com|twitch\.tv|soundcloud\.com|soundinstants\.com|myinstants\.com|shazam\.com|spotify\.com|music\.yandex|vk\.com/(video|audio|clips))", re.I)

def is_media_url(u):
    return bool(MEDIA_EXT_RE.search(u) or MEDIA_DOM_RE.search(u))

def web_netget(url, max_chars=4500):
    try:
        if is_media_url(url):
            return "ЗАПРЕЩЕНО: Скачивание видео, фото, музыки и медиа-сайтов запрещено! Используй только текстовые страницы."
        if not url.startswith(("http://", "https://")):
            url = "https://" + url
        req = urllib.request.Request(url, headers={"User-Agent": "Mozilla/5.0"})
        with urllib.request.urlopen(req, timeout=15) as resp:
            ctype = resp.headers.get("Content-Type", "").lower()
            if ctype and not any(t in ctype for t in ("text/", "json", "xml", "xhtml")):
                return f"ЗАПРЕЩЕНО: Сервер вернул медиа/бинарный файл ({ctype}). Разрешён только текст!"
            raw = resp.read().decode("utf-8", errors="ignore")
        clean = re.sub(r"<(script|style)[^>]*>.*?</\1>", " ", raw, flags=re.S | re.I)
        clean = re.sub(r"<[^>]+>", " ", clean)
        clean = re.sub(r"\s+", " ", clean).strip()
        return clean[:max_chars] + ("\n...[обрезано]" if len(clean) > max_chars else "")
    except Exception as e:
        return f"Ошибка скачивания {url}: {e}"

def classify_cmd(cmd):
    c = cmd.strip()
    if any(re.search(p, c, re.I) for p in DANGER_RE):
        return "DANGER"
    if any(re.search(p, c, re.I) for p in CAUTION_RE):
        return "CAUTION"
    return "SAFE"

