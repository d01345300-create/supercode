                elif tab == 1:
                    if hf_results and not inp.strip():
                        repo_id, _ = hf_results[hf_sel]
                        self.run_pull_process(f"hf.co/{repo_id}")
                        return
                    elif inp.strip():
                        hf_status = "Поиск на Hugging Face..."
