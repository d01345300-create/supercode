    def confirm(self, level):
        self.add_log(3, f"  [Подтвердите ({'sudo/rm' if level == 'CAUTION' else 'ASK ALL'}): Y = да / N = нет]")
        self.status = "Жду Y/N..."
        self.draw()
        while True:
            ch = self.get_key_blocking()
            if ch in ("y", "Y", "д", "Д", "\n", "\r", curses.KEY_ENTER):
                return True
            if ch in ("n", "N", "н", "Н", "\x1b"):
                return False

    def exec_cmd(self, cmd):
        if self.mode == "PLAN":
            self.add_log(3, f"  [PLAN: команда \"{cmd}\" заблокирована]")
            return "Ошибка: режим PLAN, выполнение запрещено."
        lvl = classify_cmd(cmd)
        self.add_log(1, f"  ⚙ Выполнение: `{cmd}`")
        if lvl == "DANGER":
            msg = "ЗАБЛОКИРОВАНО: критически опасная команда."
            self.add_log(4, f"  [{msg}]\n")
            return msg
        if (self.sec == "ASK ALL" or (self.sec == "SAFE AUTO" and lvl == "CAUTION")) and not self.confirm(lvl):
            msg = "Отклонено пользователем."
            self.add_log(4, f"  [{msg}]\n")
            return msg
        self.status = f"Команда: {cmd[:18]}..."
        try:
            r = subprocess.run(cmd, shell=True, text=True, capture_output=True, timeout=60)
            out = (r.stdout + r.stderr).strip() or f"(готово, код: {r.returncode})"
        except subprocess.TimeoutExpired:
            out = "(таймаут 60 сек)"
        except Exception as e:
            out = f"(ошибка: {e})"
        self.add_log(1, "  ┌─ Вывод ─────────────────────────────")
        for line in out[:2000].splitlines():
            self.add_log(8, f"  │ {line}")
        self.add_log(1, "  └─────────────────────────────────────\n")
        return shrink_text(out, 900)

    def send_msg(self, text):
        if not self.model:
            self.add_log(3, "● Сначала скачайте модель! Открываю окно загрузки [Ctrl+D]...")
            self.open_download_modal()
            if not self.model:
                return
        if self.user_turns == 0:
            self.sess_title = f"Обсуждение: {text[:24]}"
        self.add_log(9, "┃ ")
        self.add_log(9, f"┃ {text}")
        self.add_log(9, "┃ ")
        self.add_log(8, "")
        self.user_turns += 1
        api_text = text
        if self.mode == "BUILD" and self.user_turns % 2 == 0:
            api_text += (
                "\n\n[СИСТЕМНАЯ ПАМЯТКА: Ты автономный CLI-агент на ПК пользователя. "
                "Тебе РАЗРЕШЕНО и НУЖНО выполнять команды самому через //run <команда> "
                "и создавать файлы через //write <файл> ... //end. "
                "НЕ заставляй пользователя запускать команды вручную и НЕ оборачивай //run в ```!]"
            )
        self.msgs.append({"role": "user", "content": api_text})
        self.compact_context()
        self.is_busy = True
        self.abort_event.clear()
        t_start = time.time()
        self.think_start = t_start
        self.gen_phase = "wait"

        def worker():
            interrupted = False
            for step in range(1, 6):
                if self.abort_event.is_set():
                    interrupted = True
                    break
                self.status = f"Думаю (шаг {step})..."
                res_box = {"reply": None, "err": None}

                live_state = {"th": "", "txt": "", "base_len": len(self.log), "active": False}

                def _refresh_live():
                    if not self.stream_mode:
                        return
                    del self.log[live_state["base_len"]:]
                    if self.show_thinking and live_state["th"]:
                        self.log.append((7, "  ┌─ 💭 Мысли (генерирует...) ────────"))
                        for ln in live_state["th"].splitlines() or [""]:
                            self.log.append((8, f"  │ {ln}"))
                        self.log.append((7, "  └─────────────────────────────────────"))
                    if live_state["txt"]:
                        for ln in live_state["txt"].splitlines() or [""]:
                            self.log.append((8, f"  {ln}"))
                    self.scroll = 0
                    live_state["active"] = True

                def on_chunk(kind, piece):
                    if kind == "think":
                        if self.gen_phase != "think":
                            self.gen_phase = "think"
                            self.think_start = time.time()
                        live_state["th"] += piece
                    else:
                        if "<think>" in piece or ("<think>" in live_state["txt"] and "</think>" not in live_state["txt"]):
                            if self.gen_phase != "think":
                                self.gen_phase = "think"
                                self.think_start = time.time()
                        elif self.gen_phase != "text":
                            self.gen_phase = "text"
                        live_state["txt"] += piece
                    _refresh_live()

                def api_call():
                    try:
                        opts = dict(self.gen_opts, show_thinking=self.show_thinking)
                        if self.stream_mode:
                            res_box["reply"] = chat_stream(self.cfg, self.model, self.msgs, opts, on_chunk=on_chunk, abort_ev=self.abort_event)
                        else:
                            res_box["reply"] = chat(self.cfg, self.model, self.msgs, opts)
                    except Exception as ex:
                        res_box["err"] = ex

                th = threading.Thread(target=api_call, daemon=True)
                th.start()
                while th.is_alive():
                    if self.abort_event.is_set():
                        interrupted = True
                        break
                    time.sleep(0.05)
                if interrupted:
                    break
                if res_box["err"] is not None:
                    self.add_log(4, f"  [Ошибка API]: {res_box['err']}")
                    break
                if live_state["active"]:
                    del self.log[live_state["base_len"]:]
                reply = res_box["reply"] or ""
                self.msgs.append({"role": "assistant", "content": reply})
                a = parse_reply(reply, allow_run=(self.mode == "BUILD"), allow_quoted_run=self.run_in_quotes)
                if a.get("thinking"):
                    self.render_thinking_body(a["thinking"])
                if a["visible"]:
                    self.render_ai_body(a["visible"])
                if a["write"]:
                    write_file, write_buf = a["write"]
                    try:
                        fp = Path(write_file).expanduser()
                        fp.parent.mkdir(parents=True, exist_ok=True)
                        fp.write_text("\n".join(write_buf), encoding="utf-8")
                        w_msg = f"Файл {fp} успешно записан ({len(write_buf)} строк)."
                        self.add_log(1, f"  ✔ {w_msg}\n")
                    except Exception as e:
                        w_msg = f"Ошибка записи файла: {e}"
                        self.add_log(4, f"  ✘ {w_msg}\n")
                    self.msgs.append({"role": "user", "content": w_msg})
                elif a["need_ctx"]:
                    self.msgs.append({"role": "user", "content": self.read_last_context()})
                elif a["cmd"]:
                    cmd_out = self.exec_cmd(a["cmd"])
                    penalty = ""
                    if a.get("quoted_run"):
                        self.add_log(4, "  ⚠ ШТРАФ: модель обернула //run в кавычки/блок кода")
                        penalty = (
                            "\n[СИСТЕМНЫЙ ШТРАФ: ТЫ ОБЕРНУЛ //run В ОБРАТНЫЕ КАВЫЧКИ/ЦИТАТУ (` или ```)! "
                            "ПИСАТЬ ТАКИМ ОБРАЗОМ КАТЕГОРИЧЕСКИ ЗАПРЕЩЕНО! "
                            "Команда была выполнена только в режиме совместимости. "
                            "Впредь пиши //run <команда> СТРОГО с новой строки БЕЗ ``` и БЕЗ `!]\n"
                        )
                    self.msgs.append({"role": "user", "content": f"Вывод `{a['cmd']}`:\n{cmd_out}{penalty}"})
                else:
                    break
                self.compact_context()
            elapsed = time.time() - t_start
            self.render_ai_footer("прервано" if interrupted else f"{elapsed:.1f}с")
            self.save_session()
            self.status = "Готов"
            self.is_busy = False

        threading.Thread(target=worker, daemon=True).start()

    def run(self):
        self.last_esc_time = 0.0
        while True:
            self.draw()
            try:
                ch = self.stdscr.get_wch()
            except curses.error:
                continue

            # Двойное нажатие Esc во время генерации -> прерывание
            if ch == "\x1b":
                if self.is_busy:
                    now = time.time()
                    if now - self.last_esc_time < 1.2:
                        self.abort_event.set()
                        self.status = "Прерывание..."
                        self.last_esc_time = 0.0
                    else:
                        self.last_esc_time = now
                continue

            # Комбинации Ctrl+X ... работают всегда (даже во время генерации)
            if self.pending_ctrl_x:
                self.pending_ctrl_x = False
                if ch in ("l", "L", "\x0c"):
                    self.open_session_selector()
                elif ch in ("m", "M", "\r"):
                    self.open_model_selector()
                elif ch in ("n", "N", "\x0e") and not self.is_busy:
                    self.new_session()
                continue

            if ch == "\x18":
                self.pending_ctrl_x = True
            elif ch == "\x10":
                self.open_palette()
            elif ch == "\x04":
                self.open_download_modal()
            elif ch == curses.KEY_F6:
                self.toggle_quote_run()
            elif ch == "\x19":
                self.copy_last_reply()
            elif ch == "\x02":
                self.show_sidebar = not self.show_sidebar
            elif ch == curses.KEY_MOUSE:
                try:
                    _, _, _, _, bstate = curses.getmouse()
                    if bstate & curses.BUTTON4_PRESSED:
                        self.scroll += 3
                    elif bstate & curses.BUTTON5_PRESSED:
                        self.scroll = max(0, self.scroll - 3)
                except curses.error:
                    pass
            elif ch == "\t":
                self.toggle_mode()
            elif ch == curses.KEY_F2:
                self.toggle_sec()
            elif ch == curses.KEY_F3:
                self.toggle_ctx()
            elif ch == curses.KEY_F4:
                self.cycle_preset()
            elif ch == curses.KEY_F5:
                self.toggle_mouse()
            elif ch == curses.KEY_PPAGE:
                self.scroll += 5
            elif ch == curses.KEY_NPAGE:
                self.scroll = max(0, self.scroll - 5)
            elif not self.is_busy:
                if ch in ("\n", "\r", curses.KEY_ENTER):
                    t, self.buf = self.buf.strip(), ""
                    if not t:
                        continue
                    if t in ("/exit", "/quit"):
                        self.save_session()
                        break
                    elif t == "/new":
                        self.new_session()
                    elif t in ("/sessions", "/load"):
                        self.open_session_selector()
                    elif t in ("/download", "/pull"):
                        self.open_download_modal()
                    elif t == "/copy":
                        self.copy_last_reply()
                    elif t in ("/quote", "/quotes"):
                        self.toggle_quote_run()
                    elif t == "/mouse":
                        self.toggle_mouse()
                    elif t == "/mode":
                        self.toggle_mode()
                    elif t == "/sec":
                        self.toggle_sec()
                    elif t == "/ctx":
                        self.toggle_ctx()
                    elif t == "/preset":
                        self.cycle_preset()
                    elif t in ("/model", "/models"):
                        self.open_model_selector()
                    elif t in ("/auth", "/provider", "/providers"):
                        curses.def_prog_mode()
                        curses.endwin()
                        try:
                            cmd_auth()
                            self.cfg = load_config()
                        finally:
                            curses.reset_prog_mode()
                            self.stdscr.refresh()
                        self.add_log(3, "● Настройки провайдеров обновлены")
                    elif t == "/info":
                        p, model, pname = self.model_info()
                        self.add_log(1, f"● {model} · {p.get('name', pname)} [{self.model_flag()}] @ {p.get('baseURL', '')}")
                    else:
                        self.send_msg(t)
                elif ch in (curses.KEY_BACKSPACE, "\b", "\x7f"):
                    self.buf = self.buf[:-1]
                elif isinstance(ch, str) and ch.isprintable():
                    self.buf += ch


def main(argv=None):
    parser = argparse.ArgumentParser(
        prog="supercode",
        description="SuperCode — свободный opencode-подобный агент для почти любой модели (локальной или бесплатной).",
    )
    parser.add_argument("command", nargs="?", default="tui", choices=["tui", "models", "auth", "run", "config"],
                        help="tui (по умолчанию), models, auth, run, config")
    parser.add_argument("prompt", nargs="*", help="задача для 'run' или имя провайдера для 'auth'")
    parser.add_argument("-m", "--model", help="модель в формате provider/model")
    parser.add_argument("-p", "--preset", choices=list(PRESETS.keys()), default=None)
    args = parser.parse_args(argv)

    cfg = load_config()
    if args.model:
        cfg["model"] = args.model

    if args.command == "models":
        return cmd_models(cfg)
    if args.command == "auth":
        return cmd_auth(args.prompt[0] if args.prompt else None)
    if args.command == "config":
        ensure_providers_file()
        print(f"Конфиг:  {PROVIDERS_FILE}")
        print(f"Сессии:  {SESS_DIR}")
        return 0

    ref = args.model or choose_start_model(cfg)
    if args.command == "run":
        prompt = " ".join(args.prompt).strip()
        if not prompt:
            print('Использование: supercode run "задача" [-m provider/model] [-p CODE]')
            return 2
        try:
            _, p, _ = resolve_model(cfg, ref)
        except Exception as e:
            print(f"[SuperCode] {e}")
            return 1
        if p.get("type") == "ollama":
            ensure_ollama(p.get("baseURL") or API_URL)
        opts = dict(PRESETS[args.preset or "BALANCED"])
        return headless_agent(cfg, ref, prompt, opts)

    if ref:
        try:
            _, p, _ = resolve_model(cfg, ref)
            if p.get("type") == "ollama":
                ensure_ollama(p.get("baseURL") or API_URL)
        except Exception as e:
            print(f"[SuperCode] {e}")
    curses.wrapper(SuperCodeTUI, cfg, ref)
    return 0


if __name__ == "__main__":
    sys.exit(main())
