                except curses.error: pass
            try:
                self.stdscr.addstr(y0 + 1, x0 + 2, "Загрузка модели", curses.color_pair(9) | curses.A_BOLD)
                self.stdscr.addstr(y0 + 1, x0 + w - 5, "esc", curses.color_pair(9) | curses.A_DIM)
