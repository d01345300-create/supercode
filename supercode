            elif ch in ("\n", "\r", curses.KEY_ENTER):
                if tab == 0 and inp.strip(): self.run_pull_process(inp.strip()); return
                elif tab == 1 and hf_results and not inp.strip(): self.run_pull_process(f"hf.co/{hf_results[hf_sel][0]}"); return
