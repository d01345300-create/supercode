    def compact_context(self):
        base_len = 5 if self.mode == "BUILD" else 1
        if len(self.msgs) <= base_len + 4:
            return
        if self.ctx_mode == "STRICT 4K":
            while self.est_tokens() > 2600 and len(self.msgs) > base_len + 2:
                self.msgs.pop(base_len)
            return
        if self.est_tokens() > 2300:
            cut = max(2, (len(self.msgs) - base_len) // 2)
            old_chunk = self.msgs[base_len:base_len + cut]
            self.msgs = self.msgs[:base_len] + self.msgs[base_len + cut:]
            lines = [f"[{'User' if m['role']=='user' else 'AI'}]: {shrink_text(m['content'], 350)}" for m in old_chunk]
            with open(self.archive_file, "a", encoding="utf-8") as f:
                f.write("\n".join(lines) + "\n" + ("=" * 30) + "\n")
            self.offloaded_count += len(old_chunk)
            note = f"[Системная заметка: {len(old_chunk)} старых сообщ. сжаты и выгружены на SSD. Если нужны детали, напиши //lastcontext]"
            self.msgs.insert(base_len, {"role": "system", "content": note})
            self.add_log(3, f"● Контекст сжат: {len(old_chunk)} сообщ. выгружено на SSD")

    def read_last_context(self):
        if not self.archive_file.exists():
            msg = "Архив старого контекста на SSD пуст."
            self.add_log(3, f"[{msg}]")
            return msg
        chunk = self.archive_file.read_text(encoding="utf-8")[-1800:]
        self.add_log(1, f"[Загружено с SSD: {len(chunk)} симв. старого контекста]")
        return f"Фрагмент старого контекста с SSD:\n{chunk}"

