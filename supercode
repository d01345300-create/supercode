    def render_ai_body(self, text):
        in_code = False
        for line in text.splitlines():
            s = line.strip()
            if s.startswith("```"):
                if not in_code:
                    in_code = True
                    lbl = f" {s[3:].strip()} " if s[3:].strip() else " КОД "
                    self.add_log(7, f"  ┌─{lbl}" + "─" * max(4, 38 - len(lbl)))
                else:
                    in_code = False
                    self.add_log(7, "  └" + "─" * 40)
            elif in_code:
                self.add_log(7, f"  │ {line}")
            else:
                self.add_log(8, f"  {line}")
        if in_code:
            self.add_log(7, "  └" + "─" * 40)

