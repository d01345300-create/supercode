    def prompt_number(self, title, cur_val, is_int=False):
        val_str = str(cur_val)
        while True:
            self.draw()
            my, mx = self.stdscr.getmaxyx()
            w, h = min(50, mx - 4), 5
            y0, x0 = max(1, (my - h) // 2), max(2, (mx - w) // 2)
            for dy in range(h):
                try:
                    self.stdscr.addstr(y0 + dy, x0, " " * w, curses.color_pair(9))
                except curses.error:
                    pass
            try:
                self.stdscr.addstr(y0 + 1, x0 + 2, title[:w - 4], curses.color_pair(9) | curses.A_BOLD)
                self.stdscr.addstr(y0 + 2, x0 + 2, f"Значение: {val_str}_"[:w - 4], curses.color_pair(6))
                self.stdscr.addstr(y0 + 3, x0 + 2, "[Enter] Сохранить   [Esc] Отмена"[:w - 4], curses.color_pair(9) | curses.A_DIM)
            except curses.error:
                pass
            self.stdscr.refresh()
            ch = self.get_key_blocking()
            if ch == "\x1b":
                return None
            elif ch in ("\n", "\r", curses.KEY_ENTER):
                try:
                    return int(val_str) if is_int else round(float(val_str), 3)
                except ValueError:
                    return None
            elif ch in (curses.KEY_BACKSPACE, "\b", "\x7f"):
                val_str = val_str[:-1]
            elif isinstance(ch, str) and (ch.isdigit() or (ch == "." and not is_int and "." not in val_str)):
                val_str += ch

    def run_pull_process(self, pull_target):
        cmd = pull_target if pull_target.startswith("ollama pull ") else f"ollama pull {pull_target}"
        model_name = cmd.replace("ollama pull ", "").strip()
        self.add_log(3, f"● Скачивание модели: {cmd}")
        self.is_busy = True
        self.status = f"Загрузка {model_name[:18]}..."
        self.draw()
        try:
            proc = subprocess.Popen(cmd, shell=True, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True, bufsize=1)
            last_line = ""
            for raw in proc.stdout:
                clean = re.sub(r"\x1b\[[0-9;]*[a-zA-Z]", "", raw).strip()
                if clean and clean != last_line:
                    last_line = clean
                    self.status = clean[:28]
                    self.draw()
            proc.wait()
            if proc.returncode == 0:
                self.models = [m["ref"] for m in provider_models(self.cfg, discover=False)]
                ref = f"ollama/{model_name}" if "ollama" in self.cfg.get("providers", {}) else model_name
                self.model = ref
                save_model_choice(ref)
                self.add_log(2, f"● Модель {model_name} успешно скачана и выбрана!\n")
            else:
                self.add_log(4, f"● Ошибка скачивания (код {proc.returncode}): {last_line}\n")
        except Exception as e:
            self.add_log(4, f"● Ошибка запуска pull: {e}\n")
        self.is_busy = False
        self.status = "Готов"

    def open_model_selector(self):
        entries = provider_models(self.cfg)
