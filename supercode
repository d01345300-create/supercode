def clean_and_scan_providers(mode="smart"):
    raw = load_raw_config()
    ollama_models = discover_ollama_models()
    for pname, pdata in raw.get("providers", {}).items():
        if not isinstance(pdata, dict):
            continue
        if mode == "simple":
            if not pdata.get("local") and pdata.get("type") != "ollama":
                pdata["apiKey"] = ""
            pdata["models"] = list(ollama_models) if pdata.get("type") == "ollama" else []
            pdata.pop("label", None)
            pdata.pop("tags", None)
        else:
            key = (pdata.get("apiKey") or "").strip()
            env_val = os.environ.get(key[1:], "") if key.startswith("$") else key
            if pdata.get("type") == "ollama":
                pdata["models"] = list(ollama_models)
            elif not pdata.get("local") and not env_val:
                pdata["apiKey"] = ""
                pdata["models"] = []
                pdata.pop("label", None)
                pdata.pop("tags", None)
    if mode == "simple":
        raw["model"] = f"ollama/{ollama_models[0]}" if ollama_models else ""
    CONFIG_DIR.mkdir(parents=True, exist_ok=True)
    PROVIDERS_FILE.write_text(json.dumps(raw, indent=2, ensure_ascii=False) + "\n", encoding="utf-8")
    return ollama_models


def load_config():
    ensure_providers_file()
    try:
        cfg = json.loads(PROVIDERS_FILE.read_text(encoding="utf-8"))
        if not isinstance(cfg, dict) or not isinstance(cfg.get("providers"), dict):
            raise ValueError("bad config")
    except Exception:
        cfg = json.loads(default_config_text())
    for pname, p in cfg["providers"].items():
        if not isinstance(p, dict):
            cfg["providers"][pname] = dict(DEFAULT_CONFIG["providers"].get(pname, {}))
            p = cfg["providers"][pname]
        if pname in DEFAULT_CONFIG["providers"]:
            for k, v in DEFAULT_CONFIG["providers"][pname].items():
                p.setdefault(k, v)
        key = p.get("apiKey", "")
        if isinstance(key, str) and key.startswith("$"):
            p["apiKey"] = os.environ.get(key[1:], "")
        p["baseURL"] = (p.get("baseURL") or "").rstrip("/")
    return cfg


