        query, sel = "", 0
        cur = self.model
        while True:
            filtered = [m for m in entries if query.lower() in (m["ref"] + " " + m["provider_name"]).lower()]
            items = []
            for m in filtered:
                flags = "локально" if m["local"] else ("free" if m["free"] else "cloud")
                if not m["ready"]:
                    flags += " · ключ"
                tag = f"{m['provider_name'][:16]} [{flags}]"
                items.append((m["model"], tag, "model", m["ref"]))
            items.append(("Скачать модель в Ollama (Ollama / HuggingFace)...", "ctrl+d", "download", None))
            sel = max(0, min(sel, len(items) - 1))

            self.draw()
            my, mx = self.stdscr.getmaxyx()
            w = min(78, mx - 4)
            h = min(len(items) + 8, my - 2)
            y0, x0 = max(1, (my - h) // 2), max(2, (mx - w) // 2)
            for dy in range(h):
                try:
                    self.stdscr.addstr(y0 + dy, x0, " " * w, curses.color_pair(9))
                except curses.error:
                    pass
            try:
                self.stdscr.addstr(y0 + 1, x0 + 2, "Выбор модели · любой провайдер", curses.color_pair(9) | curses.A_BOLD)
                self.stdscr.addstr(y0 + 1, x0 + w - 5, "esc", curses.color_pair(9) | curses.A_DIM)
                s_disp = f"Поиск: {query}_" if query else "Поиск (начните печатать)"
                self.stdscr.addstr(y0 + 3, x0 + 2, s_disp[:w - 4], curses.color_pair(9) | (0 if query else curses.A_DIM))
                head = f"Моделей: {len(entries)}   сейчас: {self.model_short()}"
                self.stdscr.addstr(y0 + 4, x0 + 2, head[:w - 4], curses.color_pair(11) | curses.A_BOLD)

                max_rows = max(4, h - 6)
                vis_cap = max(2, max_rows - 3)
                start_row = max(0, sel - vis_cap + 1)
                for row_i in range(max_rows):
                    idx = start_row + row_i
                    if idx >= len(items):
                        break
                    title, tag, _, val = items[idx]
                    mark = "● " if val == cur else "  "
                    left_txt = f"{mark}{title}"
                    inner_w = w - 4
                    tag_disp = tag[-28:]
                    body = left_txt[:inner_w - len(tag_disp) - 1].ljust(inner_w - len(tag_disp)) + tag_disp
                    attr = (curses.color_pair(6) | curses.A_BOLD) if idx == sel else curses.color_pair(9)
                    self.stdscr.addstr(y0 + 5 + row_i, x0 + 2, body[:inner_w], attr)
            except curses.error:
                pass
            self.stdscr.refresh()

            ch = self.get_key_blocking()
            if ch == "\x1b":
                return
            elif ch == "\x04":
                self.open_download_modal()
                return
            elif ch == curses.KEY_UP:
                sel = (sel - 1) % len(items)
            elif ch == curses.KEY_DOWN:
                sel = (sel + 1) % len(items)
            elif ch in (curses.KEY_BACKSPACE, "\b", "\x7f"):
                query = query[:-1]
            elif ch in ("\n", "\r", curses.KEY_ENTER):
                _, _, act, val = items[sel]
                if act == "model":
                    self.model = val
                    cur = val
                    save_model_choice(val)
                    self.add_log(3, f"● Выбрана модель: {self.model_short()} · {self.provider_label()} [{self.model_flag()}]")
                elif act == "download":
                    self.open_download_modal()
                return
            elif isinstance(ch, str) and ch.isprintable():
                query += ch

