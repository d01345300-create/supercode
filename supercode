    def confirm(self, level):
        self.add_log(3, f"  [Подтвердите ({'sudo/rm' if level == 'CAUTION' else 'ASK ALL'}): Y = да / N = нет]")
        self.status = "Жду Y/N..."
        self.draw()
        while True:
            ch = self.get_key_blocking()
            if ch in ("y", "Y", "д", "Д", "\n", "\r", curses.KEY_ENTER):
                return True
            if ch in ("n", "N", "н", "Н", "\x1b"):
                return False

    def exec_cmd(self, cmd):
        if self.mode == "PLAN":
            self.add_log(3, f"  [PLAN: команда \"{cmd}\" заблокирована]")
            return "Ошибка: режим PLAN, выполнение запрещено."
        lvl = classify_cmd(cmd)
        if lvl == "DANGER":
            msg = "ЗАБЛОКИРОВАНО: критически опасная команда."
            self.add_log(4, f"  ✘ {msg}\n")
            return msg
        if (self.sec == "ASK ALL" or (self.sec == "SAFE AUTO" and lvl == "CAUTION")) and not self.confirm(lvl):
            msg = "Отклонено пользователем."
            self.add_log(4, f"  ✘ {msg}\n")
            return msg
        self.status = f"Команда: {cmd[:18]}..."
        self.add_log(14, f"┃ $ {cmd}")
        try:
            r = subprocess.run(cmd, shell=True, text=True, capture_output=True, timeout=60)
            out = (r.stdout + r.stderr).strip() or f"(готово, код: {r.returncode})"
        except subprocess.TimeoutExpired:
            out = "(таймаут 60 сек)"
        except Exception as e:
            out = f"(ошибка: {e})"
        lines = out[:2000].splitlines()
        self.add_log(14, "┃ ")
        for line in lines[:12]:
            self.add_log(14, f"┃ {line}")
        if len(lines) > 12:
            self.add_log(14, f"┃ ... (+{len(lines) - 12} строк)")
        self.add_log(8, "")
        return shrink_text(out, 900) if self.truncate_cmd_log else out

    def ask_low_ram_learn(self, avail_mb, kbits, ctx_sz):
        opts = [
            "1. Продолжить все равно (задействовать ZRAM / Swap)",
            "2. Отключить дообучение для экономии ОЗУ",
            "3. Отменить отправку сообщения"
        ]
        sel = 0
        while True:
            self.draw()
            my, mx = self.stdscr.getmaxyx()
            w, h = min(64, mx - 4), 10
            y0, x0 = max(1, (my - h) // 2), max(2, (mx - w) // 2)
            for dy in range(h):
                try: self.stdscr.addstr(y0 + dy, x0, " " * w, curses.color_pair(9))
                except curses.error: pass
            try:
                self.stdscr.addstr(y0 + 1, x0 + 2, f"Внимание: мало свободной ОЗУ ({avail_mb} МБ)", curses.color_pair(4) | curses.A_BOLD)
                self.stdscr.addstr(y0 + 3, x0 + 2, f"База дообучения: {kbits} кбит -> контекст {ctx_sz} токенов", curses.color_pair(9))
                for i, o in enumerate(opts):
                    attr = (curses.color_pair(6) | curses.A_BOLD) if i == sel else curses.color_pair(9)
                    self.stdscr.addstr(y0 + 5 + i, x0 + 2, o[:w - 4].ljust(w - 4), attr)
            except curses.error: pass
            self.stdscr.refresh()
            ch = self.get_key_blocking()
            if ch == curses.KEY_UP: sel = (sel - 1) % 3
            elif ch == curses.KEY_DOWN: sel = (sel + 1) % 3
            elif ch == '\x1b': return 2
            elif ch in ('\n', '\r', curses.KEY_ENTER): return sel

    def send_msg(self, text):
        if not self.model:
            self.add_log(3, "● Сначала скачайте модель! Открываю окно загрузки [Ctrl+D]...")
            self.open_download_modal()
            if not self.model:
                return
        if getattr(self, "self_learn", False):
            ctx_sz, kbits = self.calc_learn_ctx()
            avail = self._avail_ram_mb()
            if avail < 1500:
                choice = self.ask_low_ram_learn(avail, kbits, ctx_sz)
                if choice == 1: self.self_learn = False; self.save_cfg()
                elif choice == 2: return
            if getattr(self, "self_learn", False):
                self.add_log(1, f"[Дообучение] Материал: {kbits} кбит | Выделено контекста: {ctx_sz} токенов")
        if self.user_turns == 0:
            self.sess_title = f"Обсуждение: {text[:24]}"
            os.environ["SUPERCODE_EXIT_TITLE"] = self.sess_title
        self.add_log(9, "┃ ")
        self.add_log(9, f"┃ {text}")
        self.add_log(9, "┃ ")
        self.add_log(8, "")
        self.user_turns += 1
        api_text = text
        if self.allow_color_text:
            api_text += (
                "\n\n[ИНСТРУКЦИЯ ПО ЦВЕТУ: Ты можешь выделять важные слова цветом с помощью тегов "
                "<color=ЦВЕТ>текст</color> (например: <color=red>ошибка</color>, <color=green>готово</color>, "
                "<color=yellow>внимание</color>, <color=cyan>инфо</color>, <color=magenta>код</color>). "
                "Доступные цвета: red, green, yellow, cyan, magenta, blue, white. Не вкладывай теги друг в друга.]"
            )
        if self.mode == "BUILD" and self.user_turns % 2 == 0:
            api_text += (
                "\n\n[СИСТЕМНАЯ ПАМЯТКА: Ты автономный CLI-агент на ПК пользователя. "
                "Тебе РАЗРЕШЕНО и НУЖНО выполнять команды самому через //run <команда> "
                "и создавать файлы через //write <файл> ... //end. "
                "НЕ заставляй пользователя запускать команды вручную и НЕ оборачивай //run в ```!]"
            )
        if self.mode == "BUILD" and re.search(r"(найд|поищ|ищ|интернет|гугл|google|сайт|ссылк|http|новост|актуальн|сегодня|погод|курс)", text, re.I):
            api_text += (
                "\n\n[ИНСТРУКЦИЯ: Пользователь просит найти данные в сети. "
                "НЕ выдумывай ответ! Напиши ТОЛЬКО команду //search <запрос> (или //netget <url>). "
                "Система сама скачает первые 5 сайтов и отдаст тебе их текст для ответа.]"
            )
        self.msgs.append({"role": "user", "content": api_text})
        self.compact_context()
        self.is_busy = True
        self.abort_event.clear()
        t_start = time.time()
        self.think_start = t_start
        self.gen_phase = "wait"

        def worker():
            interrupted = False
            search_counts = {}
            for step in range(1, 6):
                if self.abort_event.is_set():
                    interrupted = True
                    break
                self.status = f"Думаю (шаг {step})..."
                res_box = {"reply": None, "err": None}

                live_state = {"th": "", "txt": "", "base_len": len(self.log), "active": False, "th_dur": 0.0}

                def _split_think(raw):
                    if "<think>" not in raw:
                        return "", raw
                    after = raw.split("<think>", 1)[1]
                    if "</think>" in after:
                        a, b = after.split("</think>", 1)
                        return a.strip(), b.lstrip()
                    return after.strip(), ""

                def _refresh_live():
                    if not self.stream_mode:
                        return
                    del self.log[live_state["base_len"]:]
                    ith, ctxt = _split_think(live_state["txt"])
                    cur_th = live_state["th"] or ith
                    if cur_th:
                        edur = live_state["th_dur"] or (time.time() - self.think_start)
                        if self.show_thinking:
                            self.log.append((3, f"  ∴ Thinking ({edur:.1f}s)..."))
                            for ln in cur_th.splitlines()[-14:]:
                                self.log.append((13, f"  ┃ {ln}"))
                        else:
                            self.log.append((3, f"  + Thinking... ({edur:.1f}s)"))
                    if ctxt:
                        if self.gen_phase == "think" and not live_state["th_dur"]:
                            live_state["th_dur"] = time.time() - self.think_start
                            self.gen_phase = "text"
                        for ln in ctxt.splitlines():
                            self.log.append((8, f"  {ln}"))
                    self.scroll = 0
                    live_state["active"] = True

                def on_chunk(kind, piece):
                    if kind == "think":
                        if self.gen_phase != "think":
                            self.gen_phase = "think"
                            self.think_start = time.time()
                        live_state["th"] += piece
                    else:
                        if "<think>" in piece or ("<think>" in live_state["txt"] and "</think>" not in live_state["txt"]):
                            if self.gen_phase != "think":
                                self.gen_phase = "think"
                                self.think_start = time.time()
                        else:
                            if self.gen_phase == "think" and not live_state["th_dur"]:
                                live_state["th_dur"] = time.time() - self.think_start
                            self.gen_phase = "text"
                        live_state["txt"] += piece
                    _refresh_live()

                def api_call():
                    try:
                        opts = dict(self.gen_opts, show_thinking=self.show_thinking, keep_alive=self.keep_alive, num_ctx=(self.calc_learn_ctx()[0] if self.self_learn else 4096))
                        if self.stream_mode:
                            res_box["reply"] = chat_stream(self.cfg, self.model, self.msgs, opts, on_chunk=on_chunk, abort_ev=self.abort_event)
                        else:
                            res_box["reply"] = chat(self.cfg, self.model, self.msgs, opts)
                    except Exception as ex:
                        res_box["err"] = ex

                th = threading.Thread(target=api_call, daemon=True)
                th.start()
                while th.is_alive():
                    if self.abort_event.is_set():
                        interrupted = True
                        break
                    time.sleep(0.05)
                if interrupted:
                    break
                if res_box["err"] is not None:
                    self.add_log(4, f"  [Ошибка API]: {res_box['err']}")
                    break
                if live_state["active"]:
                    del self.log[live_state["base_len"]:]
                reply = res_box["reply"] or ""
                self.msgs.append({"role": "assistant", "content": reply})
                a = parse_reply(reply, allow_run=(self.mode == "BUILD"), allow_quoted_run=self.run_in_quotes)
                th_dur = live_state["th_dur"] or ((time.time() - self.think_start) if a.get("thinking") else 0.0)
                if a.get("thinking") or th_dur > 0.2:
                    self.render_thinking_body(a["thinking"], duration=th_dur)
                if a["visible"]:
                    self.render_ai_body(a["visible"])
                if a["write"]:
                    write_file, write_buf = a["write"]
                    try:
                        fp = Path(write_file).expanduser()
                        fp.parent.mkdir(parents=True, exist_ok=True)
                        fp.write_text("\n".join(write_buf), encoding="utf-8")
                        w_msg = f"Файл {fp} успешно записан ({len(write_buf)} строк)."
                        self.add_log(1, f"  ✔ {w_msg}\n")
                    except Exception as e:
                        w_msg = f"Ошибка записи файла: {e}"
                        self.add_log(4, f"  ✘ {w_msg}\n")
                    self.msgs.append({"role": "user", "content": w_msg})
                elif a.get("search"):
                    q = a["search"]
                    if search_counts.get("_total", 0) >= 1:
                        self.add_log(3, "  ⚠ Поиск уже выполнен, переход к ответу\n")
                        self.msgs.append({"role": "user", "content": "Поиск и скачивание 5 сайтов УЖЕ ВЫПОЛНЕНЫ. Повторный //search запрещён! Проанализируй скачанные выше тексты и дай точный ответ пользователю со ссылками. Если ответа в текстах нет — честно скажи об этом."})
                        continue
                    search_counts["_total"] = 1
                    self.status = f"Поиск: {q[:18]}..."
                    if not self.web_search_on:
                        res = "Поиск в интернете отключён пользователем в настройках."
                        self.add_log(3, "  ⚠ Поиск отключён в настройках\n")
                    else:
                        self.add_log(1, f"  Поиск DuckDuckGo (топ-{self.search_limit}): {q}")
                        res = web_search_ddg(q, limit=max(5, self.search_limit))
                        urls = re.findall(r"URL:\s*(https?://\S+)", res)[:5]
                        self.add_log(1, f"  ✔ Найдено ссылок: {len(urls)}")
                        pages_txt = []
                        per_page = max(1200, self.netget_max // max(1, len(urls)))
                        for idx_u, u_item in enumerate(urls, 1):
                            self.status = f"Читаю сайт {idx_u}/{len(urls)}..."
                            self.add_log(1, f"  [{idx_u}/{len(urls)}] Скачиваю: {u_item}")
                            txt = web_netget(u_item, max_chars=per_page)
                            pages_txt.append(f"=== Сайт {idx_u}: {u_item} ===\n{txt}")
                        if pages_txt:
                            res += "\n\n" + "\n\n".join(pages_txt)
                        self.add_log(8, "")
                    self.msgs.append({"role": "user", "content": f"Результаты поиска `{q}` и тексты первых {len(urls) if self.web_search_on else 0} сайтов:\n{res}\n\n[ИНСТРУКЦИЯ: Поиск завершён. НЕ вызывай //search снова! Сразу напиши честный ответ строго по этим текстам и укажи использованные ссылки. Если нужных фактов в текстах нет — так и скажи, ничего не придумывая.]"})
                elif any(ln.strip().startswith("//note ") for ln in reply.splitlines()):
                    for ln in reply.splitlines():
                        if ln.strip().startswith("//note "):
                            res_n = self.add_learn_note(ln.strip()[7:])
                            self.add_log(3, f"  [Дообучение] {res_n}")
                            self.msgs.append({"role": "user", "content": f"Результат //note: {res_n}"})
                elif a.get("netget"):
                    u = a["netget"]
                    self.status = f"Загрузка: {u[:18]}..."
                    if not self.netget_on:
                        res = "Скачивание страниц (//netget) отключено пользователем в настройках."
                        self.add_log(3, "  ⚠ //netget отключён в настройках\n")
                    else:
                        self.add_log(1, f"  Скачивание страницы: {u}")
                        res = web_netget(u, max_chars=self.netget_max)
                        self.add_log(1, f"  ✔ Загружено {len(res)} симв.\n")
                    self.msgs.append({"role": "user", "content": f"Содержимое `{u}`:\n{res}"})
                elif a["need_ctx"]:
                    self.msgs.append({"role": "user", "content": self.read_last_context()})
                elif a["cmd"]:
                    cmd_out = self.exec_cmd(a["cmd"])
                    penalty = ""
                    if a.get("quoted_run"):
                        self.add_log(4, "  ⚠ ШТРАФ: модель обернула //run в кавычки/блок кода")
                        penalty = (
                            "\n[СИСТЕМНЫЙ ШТРАФ: ТЫ ОБЕРНУЛ //run В ОБРАТНЫЕ КАВЫЧКИ/ЦИТАТУ (` или ```)! "
                            "ПИСАТЬ ТАКИМ ОБРАЗОМ КАТЕГОРИЧЕСКИ ЗАПРЕЩЕНО! "
                            "Команда была выполнена только в режиме совместимости. "
                            "Впредь пиши //run <команда> СТРОГО с новой строки БЕЗ ``` и БЕЗ `!]\n"
                        )
                    self.msgs.append({"role": "user", "content": f"Вывод `{a['cmd']}`:\n{cmd_out}{penalty}"})
                else:
                    break
                self.compact_context()
            elapsed = time.time() - t_start
            self.render_ai_footer("прервано" if interrupted else f"{elapsed:.1f}с")
            self.save_session()
            self.status = "Готов"
            self.is_busy = False

        threading.Thread(target=worker, daemon=True).start()

    def print_exit_banner(self):
        os.environ["SUPERCODE_EXIT_TITLE"] = self.sess_title
        os.environ["SUPERCODE_EXIT_SID"] = self.sess_id

    def run(self):
        os.environ["SUPERCODE_EXIT_TITLE"] = self.sess_title
        os.environ["SUPERCODE_EXIT_SID"] = self.sess_id
        self.last_esc_time = 0.0
        while True:
            self.draw()
            try:
                ch = self.stdscr.get_wch()
            except curses.error:
                continue

            # Двойное нажатие Esc во время генерации -> прерывание
            if ch == "\x1b":
                if self.is_busy:
                    self.abort_event.set()
                    self.status = "Прерывание..."
                    r_sock = getattr(self, "_active_resp", None)
                    if r_sock:
                        try: r_sock.close()
                        except Exception: pass
                continue

            # Комбинации Ctrl+X ... работают всегда (даже во время генерации)
            if self.pending_ctrl_x:
                self.pending_ctrl_x = False
                if ch in ("l", "L", "\x0c"):
                    self.open_session_selector()
                elif ch in ("m", "M", "\r"):
                    self.open_model_selector()
                elif ch in ("n", "N", "\x0e") and not self.is_busy:
                    self.new_session()
                continue

            if ch == "\x18":
                self.pending_ctrl_x = True
            elif ch == "\x10":
                self.open_palette()
            elif ch == "\x04":
                self.open_download_modal()
            elif ch == curses.KEY_F6:
                self.toggle_quote_run()
            elif ch == curses.KEY_F7:
                self.toggle_thinking()
            elif ch == "\x19":
                self.copy_last_reply()
            elif ch == "\x02":
                self.show_sidebar = not self.show_sidebar
            elif ch == curses.KEY_MOUSE:
                try:
                    _, _, _, _, bstate = curses.getmouse()
                    if bstate & curses.BUTTON4_PRESSED:
                        self.scroll += 3
                    elif bstate & curses.BUTTON5_PRESSED:
                        self.scroll = max(0, self.scroll - 3)
                except curses.error:
                    pass
            elif ch == "\t":
                self.toggle_mode()
            elif ch == curses.KEY_F2:
                self.toggle_sec()
            elif ch == curses.KEY_F3:
                self.toggle_ctx()
            elif ch == curses.KEY_F4:
                self.cycle_preset()
            elif ch == curses.KEY_F5:
                self.toggle_mouse()
            elif ch == curses.KEY_PPAGE:
                self.scroll += 5
            elif ch == curses.KEY_NPAGE:
                self.scroll = max(0, self.scroll - 5)
            elif not self.is_busy:
                if ch in ("\n", "\r", curses.KEY_ENTER):
                    t, self.buf = self.buf.strip(), ""
                    if not t:
                        continue
                    if t in ("/exit", "/quit"):
                        self.save_session()
                        os.environ["SUPERCODE_EXIT_TITLE"] = self.sess_title
                        os.environ["SUPERCODE_EXIT_SID"] = self.sess_id
                        self.print_exit_banner()
                        break
                    elif t == "/new":
                        self.new_session()
                    elif t in ("/sessions", "/load"):
                        self.open_session_selector()
                    elif t in ("/download", "/pull"):
                        self.open_download_modal()
                    elif t == "/copy":
                        self.copy_last_reply()
                    elif t in ("/quote", "/quotes"):
                        self.toggle_quote_run()
                    elif t == "/mouse":
                        self.toggle_mouse()
                    elif t == "/mode":
                        self.toggle_mode()
                    elif t == "/sec":
                        self.toggle_sec()
                    elif t == "/ctx":
                        self.toggle_ctx()
                    elif t == "/preset":
                        self.cycle_preset()
                    elif t in ("/model", "/models"):
                        self.open_model_selector()
                    elif t in ("/auth", "/provider", "/providers"):
                        curses.def_prog_mode()
                        curses.endwin()
                        try:
                            cmd_auth()
                            self.cfg = load_config()
                        finally:
                            curses.reset_prog_mode()
                            self.stdscr.refresh()
                        self.add_log(3, "● Настройки провайдеров обновлены")
                    elif t == "/info":
                        p, model, pname = self.model_info()
                        self.add_log(1, f"● {model} · {p.get('name', pname)} [{self.model_flag()}] @ {p.get('baseURL', '')}")
                    else:
                        self.send_msg(t)
                elif ch in (curses.KEY_BACKSPACE, "\b", "\x7f"):
                    self.buf = self.buf[:-1]
                elif isinstance(ch, str) and ch.isprintable():
                    self.buf += ch


def main(argv=None):
    parser = argparse.ArgumentParser(
        prog="supercode",
        description="SuperCode — свободный opencode-подобный агент для почти любой модели (локальной или бесплатной).",
    )
    parser.add_argument("command", nargs="?", default="tui", choices=["tui", "models", "auth", "run", "config"],
                        help="tui (по умолчанию), models, auth, run, config")
    parser.add_argument("prompt", nargs="*", help="задача для 'run' или имя провайдера для 'auth'")
    parser.add_argument("-m", "--model", help="модель в формате provider/model")
    parser.add_argument("-p", "--preset", choices=list(PRESETS.keys()), default=None)
    parser.add_argument("-s", "--session", default=None, help="ID сессии для продолжения")
    args = parser.parse_args(argv)

    cfg = load_config()
    if args.model:
        cfg["model"] = args.model

    if args.command == "models":
        return cmd_models(cfg)
    if args.command == "auth":
        return cmd_auth(args.prompt[0] if args.prompt else None)
    if args.command == "config":
        ensure_providers_file()
        print(f"Конфиг:  {PROVIDERS_FILE}")
        print(f"Сессии:  {SESS_DIR}")
        return 0

    ref = args.model or cfg.get("model") or choose_start_model(cfg)
    if args.command == "run":
        prompt = " ".join(args.prompt).strip()
        if not prompt:
            print('Использование: supercode run "задача" [-m provider/model] [-p CODE]')
            return 2
        try:
            _, p, _ = resolve_model(cfg, ref)
        except Exception as e:
            print(f"[SuperCode] {e}")
            return 1
        if p.get("type") == "ollama":
            ensure_ollama(p.get("baseURL") or API_URL)
        opts = dict(PRESETS[args.preset or "BALANCED"])
        return headless_agent(cfg, ref, prompt, opts)

    ensure_ollama(cfg.get("providers", {}).get("ollama", {}).get("baseURL") or API_URL)
    cfg = load_config()
    ref = args.model or choose_start_model(cfg)
    if args.session:
        os.environ["SUPERCODE_START_SID"] = args.session
    try:
        curses.wrapper(SuperCodeTUI, cfg, ref)
    except KeyboardInterrupt:
        pass
    sid = os.environ.get("SUPERCODE_EXIT_SID", "")
    title = os.environ.get("SUPERCODE_EXIT_TITLE", "Новая сессия")
    if sid:
        print()
        for ln in LOGO:
            print(f"\033[1;37m{ln}\033[0m")
        print(f"\n\033[90mSession   \033[0m\033[1m{title}\033[0m")
        print(f"\033[90mContinue  \033[0m\033[37msupercode -s {sid}\033[0m\n")
    return 0


if __name__ == "__main__":
    sys.exit(main())
