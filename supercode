                    self.stdscr.addstr(y0 + 5, x0 + 2, f"{lbl} {inp}_"[:w - 4], curses.color_pair(10 if tab == 0 else 11) | curses.A_BOLD)
                if tab == 0:
                    for idx, hl in enumerate(["Примеры: qwen2.5-coder:3b, qwen3:4b, qwen3:8b", "Нажмите [Enter] для скачивания в Ollama."]):
                        self.stdscr.addstr(y0 + 7 + idx, x0 + 2, hl[:w - 4], curses.color_pair(9) | curses.A_DIM)
