def discover_ollama_models(base=API_URL, timeout=2):
    try:
        with urllib.request.urlopen(f"{base.rstrip('/')}/api/tags", timeout=timeout) as r:
            return [m["name"] for m in json.loads(r.read().decode()).get("models", [])]
    except Exception:
        return []


def provider_models(cfg, discover=True):
    """Единый список моделей: provider/model + метаданные."""
    out, seen = [], set()
    for pname, p in cfg.get("providers", {}).items():
        if p.get("enabled", True) is False:
            continue
        models = list(p.get("models") or [])
        if p.get("type") == "ollama" and discover:
            for m in discover_ollama_models(p.get("baseURL") or API_URL):
                if m not in models:
                    models.append(m)
        ready = bool(p.get("apiKey")) or bool(p.get("local")) or p.get("type") == "ollama"
        for model in models:
            ref = f"{pname}/{model}"
            if ref in seen:
                continue
            seen.add(ref)
            out.append({
                "ref": ref, "provider": pname, "model": model,
                "provider_name": p.get("name", pname),
                "free": bool(p.get("free")), "local": bool(p.get("local")),
                "ready": ready,
            })
    return out


def resolve_model(cfg, ref=None):
    ref = (ref or cfg.get("model") or "").strip()
    if "/" in ref:
        pname, model = ref.split("/", 1)
        if pname not in cfg.get("providers", {}):
            pname, model = "ollama", ref
    else:
        pname, model = "ollama", ref
    p = cfg["providers"].get(pname)
    if not p:
        raise RuntimeError(f"Провайдер '{pname}' не найден в {PROVIDERS_FILE}")
    return pname, p, model


def choose_start_model(cfg):
    models = provider_models(cfg)
    ref = cfg.get("model")
    if ref and any(m["ref"] == ref for m in models):
        return ref
    ready = [m for m in models if m["ready"]]
    if ready:
        return ready[0]["ref"]
    return models[0]["ref"] if models else ""


def search_hf_gguf(query):
    q = urllib.parse.quote(query.strip() or "qwen coder")
    url = f"https://huggingface.co/api/models?search={q}&filter=gguf&sort=downloads&direction=-1&limit=10"
    req = urllib.request.Request(url, headers={"User-Agent": "SuperCode/2.2"})
    with urllib.request.urlopen(req, timeout=10) as r:
        data = json.loads(r.read().decode())
    return [(m.get("id", ""), m.get("downloads", 0)) for m in data if isinstance(m, dict) and m.get("id")]


def _post_json(url, payload, headers=None, timeout=300):
    h = {"Content-Type": "application/json"}
    if headers:
        h.update({k: v for k, v in headers.items() if v})
    req = urllib.request.Request(url, data=json.dumps(payload).encode(), headers=h)
    try:
        with urllib.request.urlopen(req, timeout=timeout) as r:
            return json.loads(r.read().decode())
    except urllib.error.HTTPError as e:
        body = e.read().decode(errors="ignore")
        body = re.sub(r"\s+", " ", body).strip()[:400]
        raise RuntimeError(f"HTTP {e.code}: {body}")
    except urllib.error.URLError as e:
        raise RuntimeError(f"Сеть недоступна: {e.reason}")


