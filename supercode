def cmd_auth(provider=None):
    cfg = load_raw_config()
    names = list(cfg.get("providers", {}).keys())
    if provider and provider not in cfg["providers"]:
        name = provider
        cfg["providers"][name] = {"type": "openai", "name": name, "enabled": True,
                                  "baseURL": "", "apiKey": "", "models": []}
        names.append(name)
    if not provider:
        print("Провайдеры:")
        for i, n in enumerate(names, 1):
            p = cfg["providers"][n]
            mark = "✓" if (p.get("apiKey") or p.get("local")) else "·"
            print(f"  {i:2}. {mark} {n:<12} {p.get('name', '')}  {p.get('baseURL', '')}")
        raw = input(f"\nНомер или имя провайдера [1]: ").strip()
        if not raw:
            provider = names[0]
        elif raw.isdigit() and 1 <= int(raw) <= len(names):
            provider = names[int(raw) - 1]
        else:
            provider = raw
        if provider not in cfg["providers"]:
            cfg["providers"][provider] = {"type": "openai", "name": provider, "enabled": True,
                                          "baseURL": "", "apiKey": "", "models": []}
    p = cfg["providers"][provider]
    print(f"\nНастройка провайдера: {provider}")
    base = input(f"  baseURL [{p.get('baseURL', '')}]: ").strip()
    if base:
        p["baseURL"] = base.rstrip("/")
    key = input("  API key (Enter — оставить, '-' — очистить): ").strip()
    if key == "-":
        p["apiKey"] = ""
    elif key:
        p["apiKey"] = key
    models = input("  Модели через запятую: ").strip()
    if models:
        p["models"] = [m.strip() for m in models.split(",") if m.strip()]
    raw_type = input(f"  Тип API [openai/ollama/anthropic/google] ({p.get('type', 'openai')}): ").strip()
    if raw_type:
        p["type"] = raw_type
    enabled = input("  Включить? [Y/n]: ").strip().lower()
    p["enabled"] = enabled not in ("n", "no", "н", "нет")
    if not cfg.get("model") and p.get("models"):
        cfg["model"] = f"{provider}/{p['models'][0]}"
    try:
        CONFIG_DIR.mkdir(parents=True, exist_ok=True)
        PROVIDERS_FILE.write_text(json.dumps(cfg, indent=2, ensure_ascii=False) + "\n", encoding="utf-8")
        print(f"\n✔ Сохранено: {PROVIDERS_FILE}")
        print(f"  Текущая модель: {cfg.get('model') or '(не задана)'}")
    except Exception as e:
        print(f"Ошибка сохранения: {e}")
        return 1
    return 0


class SuperCodeTUI:
    def _learn_file(self):
        return CONFIG_DIR / "learn_notes.txt"

    def _avail_ram_mb(self):
        try:
            for ln in open("/proc/meminfo"):
                if ln.startswith("MemAvailable:"): return int(ln.split()[1]) // 1024
        except Exception: pass
        return 4096

    def calc_learn_ctx(self):
        fp = self._learn_file()
        raw_bytes = fp.stat().st_size if fp.exists() else 0
        kbits = max(1, (raw_bytes * 8 + 999) // 1000)
        if not getattr(self, "smart_learn_alloc", True):
            return int(self.learn_ctx), kbits
        need_ctx = max(2048, min(16384, 2048 + (raw_bytes // 2)))
        return need_ctx, kbits

    def get_learn_block(self):
        if not getattr(self, "self_learn", False): return ""
        fp = self._learn_file()
        notes = fp.read_text(encoding="utf-8").strip() if fp.exists() else ""
        rules = (
            "\n[РЕЖИМ ДООБУЧЕНИЯ И БАЗА ПРАВИЛ ВКЛЮЧЕНЫ]\n"
            "Когда понял, как НЕЛЬЗЯ писать код или нашел ошибку — запиши правило с новой строки: //note <краткое техническое правило>\n"
            "СТРОГИЙ ЗАПРЕТ: НИКОГДА не записывай в //note данные пользователя (имена, пароли, токены, IP, пути /home/...).\n"
        )
        return rules + (f"НАКОПЛЕННЫЕ ПРАВИЛА:\n{notes[-3500:]}\n" if notes else "")

    def add_learn_note(self, text):
        t = text.strip()
        if len(t) < 8: return "Заметка слишком короткая."
        if re.search(r"(/home/|/Users/|C:\\|sk-|ghp_|password|пароль|токен|token|192\.168\.|dima|дима)", t, re.I):
            return "ОТКЛОНЕНО: запрещено сохранять личные данные или пути пользователя."
        CONFIG_DIR.mkdir(parents=True, exist_ok=True)
        fp = self._learn_file()
        old = fp.read_text(encoding="utf-8").splitlines() if fp.exists() else []
        if t not in old:
            old.append("- " + t.lstrip("- "))
            fp.write_text("\n".join(old[-60:]) + "\n", encoding="utf-8")
        return "Правило сохранено в базу дообучения."

