                        self.stdscr.addstr(y0 + 7 + r_i, x0 + 2, row_txt, (curses.color_pair(6) | curses.A_BOLD) if idx == ready_sel else curses.color_pair(9))
            except curses.error: pass
            self.stdscr.refresh()
            ch = self.get_key_blocking()
            if ch in ("\x1b", "\x04"): return
            elif ch in ("\t", curses.KEY_RIGHT): tab, inp = (tab + 1) % 3, ""
            elif ch == curses.KEY_LEFT: tab, inp = (tab - 1) % 3, ""
            elif ch == curses.KEY_UP:
                if tab == 1 and hf_results: hf_sel = (hf_sel - 1) % len(hf_results)
                elif tab == 2: ready_sel = (ready_sel - 1) % len(READY_MODELS)
            elif ch == curses.KEY_DOWN:
                if tab == 1 and hf_results: hf_sel = (hf_sel + 1) % len(hf_results)
                elif tab == 2: ready_sel = (ready_sel + 1) % len(READY_MODELS)
