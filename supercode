    def get_sys_metrics(self):
        now = time.time()
        if now - self._sys_cache[0] < 1.5 and self._sys_cache[1]:
            return self._sys_cache[1]
        # CPU % из /proc/stat
        cpu_pct = 0.0
        try:
            with open("/proc/stat") as f:
                parts = [float(x) for x in f.readline().split()[1:8]]
            idle, total = parts[3] + parts[4], sum(parts)
            prev = getattr(self, "_prev_cpu", None)
            if prev and total > prev[1]:
                cpu_pct = max(0.0, min(100.0, (1.0 - (idle - prev[0]) / (total - prev[1])) * 100.0))
            self._prev_cpu = (idle, total)
        except Exception:
            pass
        # ОЗУ ГБ / ГБ из /proc/meminfo
        ram_str = "ОЗУ: н/д"
        try:
            mi = {}
            with open("/proc/meminfo") as f:
                for line in f:
                    k, v = line.split(":", 1)
                    mi[k] = int(v.strip().split()[0])
            tot_gb = mi["MemTotal"] / 1048576
            used_gb = (mi["MemTotal"] - mi.get("MemAvailable", mi.get("MemFree", 0))) / 1048576
            ram_str = f"ОЗУ: {used_gb:.1f}/{tot_gb:.1f} ГБ"
        except Exception:
            pass
        # Диск ГБ / ГБ
        try:
            du = shutil.disk_usage(os.path.expanduser("~"))
            disk_str = f"Диск: {du.used / (1024**3):.0f}/{du.total / (1024**3):.0f} ГБ"
        except Exception:
            disk_str = "Диск: н/д"
        # Сеть (проверка активного маршрута в /proc/net/route)
        online = False
        try:
            with open("/proc/net/route") as f:
                for line in f.readlines()[1:]:
                    cols = line.split()
                    if len(cols) > 3 and cols[1] == "00000000" and (int(cols[3], 16) & 2):
                        online = True
                        break
        except Exception:
            pass
        res = [
            (f"ЦП: {cpu_pct:4.1f}%", curses.color_pair(2 if cpu_pct < 75 else 4)),
            (ram_str, curses.color_pair(1)),
            (disk_str, curses.color_pair(8) | curses.A_DIM),
            ("Сеть: онлайн" if online else "Сеть: офлайн", curses.color_pair(2 if online else 4)),
        ]
        self._sys_cache = (now, res)
        return res

    def draw_busy_indicator(self, y, x):
        frames = ["⠋", "⠙", "⠹", "⠸", "⠼", "⠴", "⠦", "⠧", "⠇", "⠏"]
        spin = frames[self.anim_tick % len(frames)]
        dots = "." * ((self.anim_tick // 3) % 4)
        self.anim_tick += 1
        phase = getattr(self, "gen_phase", "wait")
        elapsed = time.time() - getattr(self, "think_start", time.time())
        if phase == "think":
            lbl = f"{spin} thinking{dots:<3} {elapsed:4.1f}с"
            attr = curses.color_pair(2) | curses.A_BOLD
        elif phase == "text":
            lbl = f"{spin} ответ{dots:<3}"
            attr = curses.color_pair(1) | curses.A_BOLD
        else:
            lbl = f"{spin} ожидание{dots:<3}"
            attr = curses.color_pair(3) | curses.A_DIM
        try:
            self.stdscr.addstr(y, x, lbl, attr)
            nx = x + len(lbl) + 2
            self.stdscr.addstr(y, nx, "esc", curses.color_pair(8) | curses.A_BOLD)
            esc_hint = "прервать "
            self.stdscr.addstr(y, nx + 4, f"{esc_hint}· {self.status}", curses.color_pair(8) | curses.A_DIM)
        except curses.error:
            pass

