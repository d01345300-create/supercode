            self.add_log(7, f"  Настройте API через supercode auth ({PROVIDERS_FILE}) или скачайте локальную.\n")
        if os.environ.pop("SUPERCODE_OPEN_DL", "") == "1":
            self.open_download_modal(default_tab=2)
        start_sid = os.environ.pop("SUPERCODE_START_SID", "")
        if start_sid:
            sp = SESS_DIR / f"session_{start_sid.removeprefix('session_')}.json"
            if sp.exists(): self.load_session(sp)
            else: self.add_log(4, f"● Сессия {start_sid} не найдена")
        try:
            if CFG_FILE.exists():
                _d = json.loads(CFG_FILE.read_text(encoding="utf-8"))
                for _k, _v in _d.items():
                    if hasattr(self, _k) and not callable(getattr(self, _k)) and _k not in ("stdscr", "log", "msgs", "sess_id"):
                        setattr(self, _k, _v)
        except Exception:
            pass
        if getattr(self, "self_learn", False) and self.msgs:
            self.msgs["content"] = PROMPT_BUILD + self.get_learn_block()
        self.run()

