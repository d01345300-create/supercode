    def copy_last_reply(self):
        last_ai = next((m["content"] for m in reversed(self.msgs) if m["role"] == "assistant" and "//run ls -la" not in m["content"]), "")
        if not last_ai:
            self.add_log(3, "● Нет ответа ИИ для копирования")
            return
        (BASE_DIR / "last_reply.txt").write_text(last_ai, encoding="utf-8")
        copied = False
        for cmd in (["wl-copy"], ["xclip", "-selection", "clipboard"], ["xsel", "--clipboard", "--input"]):
            if shutil.which(cmd):
                try:
                    subprocess.run(cmd, input=last_ai, text=True, check=True, timeout=3)
                    copied = True
                    break
                except Exception:
                    pass
        if copied:
            self.add_log(2, f"● Ответ ИИ скопирован в буфер обмена ({len(last_ai)} симв.)")
        else:
