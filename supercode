                    self.stdscr.addstr(i, 2, " " * (main_w - 4), curses.color_pair(9))
                    self.stdscr.addstr(i, 2, "┃", curses.color_pair(card_accent if c == 9 else 14) | curses.A_BOLD)
                    attr = curses.color_pair(9) | (curses.A_BOLD if line.startswith("┃ $ ") else 0)
                    self.stdscr.addstr(i, 3, line[1:main_w - 4], attr)
                elif c == 13:
                    self.stdscr.addstr(i, 1, line[:main_w - 2], curses.color_pair(8) | curses.A_DIM)
                elif c == 12:
                    self.stdscr.addstr(i, 1, line[:main_w - 2], curses.color_pair(12) | curses.A_BOLD)
                elif "`" in line and not line.lstrip().startswith("┃"):
                    cx = 1
                    for seg in re.split(r"(`[^`]+`)", line):
                        if not seg or cx >= main_w - 1: continue
                        if seg.startswith("`") and seg.endswith("`") and len(seg) > 2:
                            inner = f" {seg[1:-1]} "[:main_w - 1 - cx]
                            self.stdscr.addstr(i, cx, inner, curses.color_pair(14) | curses.A_BOLD)
                            cx += len(inner)
                        else:
                            part = seg[:main_w - 1 - cx]
                            self.stdscr.addstr(i, cx, part, curses.color_pair(c) | (curses.A_BOLD if c in (5, 7) else 0))
                            cx += len(part)
                elif "<color=" in line:
                    cmap = {"cyan": 1, "blue": 1, "green": 2, "yellow": 3, "red": 4, "magenta": 7, "white": 8}
                    cx = 1
                    for seg in re.split(r"(<color=[a-zA-Z]+>.*?</(?:color|a)>)", line):
                        if not seg or cx >= main_w - 1:
                            continue
                        m = re.match(r"^<color=([a-zA-Z]+)>(.*?)</(?:color|a)>$", seg)
                        if m and self.allow_color_text:
                            col_id = cmap.get(m.group(1).lower(), c)
                            txt_p = m.group(2)[:main_w - 1 - cx]
                            self.stdscr.addstr(i, cx, txt_p, curses.color_pair(col_id) | curses.A_BOLD)
                            cx += len(txt_p)
                        else:
                            clean_p = re.sub(r"</?(?:color(?:=[a-zA-Z]+)?|a)>", "", seg)[:main_w - 1 - cx]
                            self.stdscr.addstr(i, cx, clean_p, curses.color_pair(c) | (curses.A_BOLD if c in (5, 7) else 0))
                            cx += len(clean_p)
                else:
                    self.stdscr.addstr(i, 1, line[:main_w - 2], curses.color_pair(c) | (curses.A_BOLD if c in (5, 7) else 0))
            except curses.error:
                pass

        if side_w:
            sx = main_w + 1
            for y in range(my - 1):
                try:
                    self.stdscr.addstr(y, main_w, "│", curses.color_pair(8) | curses.A_DIM)
                except curses.error:
                    pass
            tok = self.est_tokens()
            pct = min(100, int(tok * 100 / 4096))
            side_info = [
                (self.sess_title[:side_w - 3], curses.color_pair(8) | curses.A_BOLD),
                ("", 0),
                ("Контекст", curses.color_pair(8) | curses.A_BOLD),
                (f"{tok} токенов", curses.color_pair(8) | curses.A_DIM),
                (f"{pct}% занято · $0.00", curses.color_pair(8) | curses.A_DIM),
                (f"{self.ctx_mode} · SSD: {self.offloaded_count}", curses.color_pair(1)),
                ("", 0),
                ("Генерация", curses.color_pair(8) | curses.A_BOLD),
                (f"Пресет: {self.preset_name}", curses.color_pair(2)),
                (f"temp:{self.gen_opts['temperature']} top_p:{self.gen_opts['top_p']}", curses.color_pair(8) | curses.A_DIM),
                (f"top_k:{self.gen_opts['top_k']} rep:{self.gen_opts['repeat_penalty']}", curses.color_pair(8) | curses.A_DIM),
                ("", 0),
                ("Агент и защита", curses.color_pair(8) | curses.A_BOLD),
                (f"Режим: {self.mode.capitalize()}", curses.color_pair(12 if self.mode == "BUILD" else 3)),
                (f"Защита: {self.sec}", curses.color_pair(sc)),
                (self.status[:side_w - 3], curses.color_pair(3)),
            ]
            for idx, (stext, sattr) in enumerate(side_info):
                if idx < my - 8:
                    try:
                        self.stdscr.addstr(1 + idx, sx + 1, stext[:side_w - 2], sattr)
                    except curses.error:
                        pass
            sys_rows = self.get_sys_metrics()
            sep_y = my - 7
            if sep_y > len(side_info) + 1:
                try:
                    self.stdscr.addstr(sep_y, sx + 1, "─" * (side_w - 3), curses.color_pair(8) | curses.A_DIM)
                    for r_i, (r_txt, r_attr) in enumerate(sys_rows):
                        self.stdscr.addstr(sep_y + 1 + r_i, sx + 1, r_txt[:side_w - 2], r_attr)
                except curses.error:
                    pass

        box_w = main_w - 4
        try:
            for r_i in range(4):
                self.stdscr.addstr(my - 5 + r_i, 2, " " * box_w, curses.color_pair(9))
            self.stdscr.addstr(my - 5, 2, "┃", curses.color_pair(card_accent) | curses.A_BOLD)
            prompt = "Вы > " if not self.is_busy else "Ожидание... "
            avail = box_w - len(prompt) - 4
            shown = self.buf[-avail:] if len(self.buf) > avail else self.buf
            self.stdscr.addstr(my - 4, 2, "┃ ", curses.color_pair(card_accent) | curses.A_BOLD)
            self.stdscr.addstr(prompt, curses.color_pair(9) | (curses.A_DIM if self.is_busy else curses.A_BOLD))
            self.stdscr.addstr(shown, curses.color_pair(9))
            self.stdscr.addstr(my - 3, 2, "┃ ", curses.color_pair(card_accent) | curses.A_BOLD)
            self.stdscr.addstr(self.mode.capitalize(), curses.color_pair(card_accent) | curses.A_BOLD)
            self.stdscr.addstr(f" · {model_label} · {self.provider_label()} [{self.model_flag()}]", curses.color_pair(9) | curses.A_DIM)
            self.stdscr.addstr(my - 2, 2, "┃", curses.color_pair(card_accent) | curses.A_BOLD)
            if self.is_busy:
                self.draw_busy_indicator(my - 1, 2)
            else:
                q_lbl = "● цитаты://run"
                q_attr = (curses.color_pair(2) | curses.A_BOLD) if self.run_in_quotes else (curses.color_pair(8) | curses.A_DIM)
                self.stdscr.addstr(my - 1, 2, q_lbl, q_attr)
                cwd_x = 2 + len(q_lbl) + 2
                if main_w - cwd_x > 34:
                    self.stdscr.addstr(my - 1, cwd_x, cwd_short[:main_w - cwd_x - 30], curses.color_pair(8) | curses.A_DIM)
                r_hints = "tab режимы   ctrl+p команды"
                if main_w > len(r_hints) + len(q_lbl) + 6:
                    self.stdscr.addstr(my - 1, main_w - len(r_hints) - 2, r_hints, curses.color_pair(8) | curses.A_DIM)
            if side_w:
                self.stdscr.addstr(my - 1, main_w + 2, "● SuperCode 1.4"[:side_w - 2], curses.color_pair(2) | curses.A_BOLD)
            self.stdscr.move(my - 4, min(box_w, 4 + len(prompt) + len(shown)))
        except curses.error:
