                self.stdscr.addstr(y0 + 2, x0 + 2, f"Значение: {val_str}_"[:w - 4], curses.color_pair(6))
                self.stdscr.addstr(y0 + 3, x0 + 2, "[Enter] Сохранить   [Esc] Отмена"[:w - 4], curses.color_pair(9) | curses.A_DIM)
            except curses.error:
