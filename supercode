                t2_attr = (curses.color_pair(6) | curses.A_BOLD) if tab == 1 else (curses.color_pair(9) | curses.A_DIM)
                self.stdscr.addstr(y0 + 3, x0 + 2, " 1. Ollama Pull ", t1_attr)
                self.stdscr.addstr(y0 + 3, x0 + 20, " 2. Hugging Face (GGUF) ", t2_attr)
                self.stdscr.addstr(y0 + 3, x0 + w - 18, "[←/→ Tab] вкладка", curses.color_pair(9) | curses.A_DIM)

                lbl = "Команда / тег:" if tab == 0 else "Поиск на HF:"
                self.stdscr.addstr(y0 + 5, x0 + 2, f"{lbl} {inp}_"[:w - 4], curses.color_pair(10 if tab == 0 else 11) | curses.A_BOLD)

                if tab == 0:
                    hints = [
                        "Примеры для ввода:",
                        "  qwen2.5-coder:3b      (быстрая для кода, ~1.9 ГБ)",
                        "  qwen3.5:4b            (умная универсальная, ~2.7 ГБ)",
                        "  llama3.2:3b           (лёгкая модель от Meta)",
                        "Нажмите [Enter] для начала скачивания.",
                    ]
                    for idx, hl in enumerate(hints):
                        if 7 + idx < h - 1:
                            self.stdscr.addstr(y0 + 7 + idx, x0 + 2, hl[:w - 4], curses.color_pair(9) | curses.A_DIM)
                else:
                    self.stdscr.addstr(y0 + 6, x0 + 2, hf_status[:w - 4], curses.color_pair(11))
                    max_r = h - 9
                    start_r = max(0, hf_sel - max_r + 1)
                    for r_i in range(max_r):
                        idx = start_r + r_i
                        if idx >= len(hf_results):
                            break
                        repo_id, dls = hf_results[idx]
                        row_txt = f"hf.co/{repo_id}".ljust(w - 14)[:w - 14] + f" ↓{dls}"
                        attr = (curses.color_pair(6) | curses.A_BOLD) if idx == hf_sel else curses.color_pair(9)
                        self.stdscr.addstr(y0 + 8 + r_i, x0 + 2, row_txt[:w - 4], attr)
            except curses.error:
                pass
            self.stdscr.refresh()

            ch = self.get_key_blocking()
            if ch in ("\x1b", "\x04"):
                return
            elif ch in ("\t", curses.KEY_LEFT, curses.KEY_RIGHT):
                tab = 1 - tab
                inp = ""
            elif ch == curses.KEY_UP and tab == 1 and hf_results:
                hf_sel = (hf_sel - 1) % len(hf_results)
            elif ch == curses.KEY_DOWN and tab == 1 and hf_results:
                hf_sel = (hf_sel + 1) % len(hf_results)
            elif ch in (curses.KEY_BACKSPACE, "\b", "\x7f"):
                inp = inp[:-1]
            elif ch in ("\n", "\r", curses.KEY_ENTER):
                if tab == 0 and inp.strip():
                    self.run_pull_process(inp.strip())
