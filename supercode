            self.add_log(3, f"● Веб-настройки открыты в браузере: {self._web_url}")
            return
        class Handler(BaseHTTPRequestHandler):
            def log_message(self, *a): pass
            def do_GET(self):
                if self.path == "/api/cfg":
                    try:
                        raw = urllib.request.urlopen(f"{app.ollama_url}/api/tags", timeout=2).read().decode()
                        models = [m["name"] for m in json.loads(raw).get("models", [])]
                    except Exception:
                        models = [app.model]
                    if app.model not in models: models.insert(0, app.model)
                    data = {
                        "model": app.model, "models": models, "ollama_url": app.ollama_url,
                        "custom_api_url": app.custom_api_url, "api_keys": app.api_keys,
                        "keep_alive": app.keep_alive, "self_learn": app.self_learn, "smart_learn_alloc": app.smart_learn_alloc, "show_thinking": app.show_thinking,
                        "allow_color_text": app.allow_color_text, "truncate_cmd_log": app.truncate_cmd_log,
