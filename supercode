def default_config_text():
    return json.dumps(DEFAULT_CONFIG, indent=2, ensure_ascii=False) + "\n"


def ensure_providers_file():
    try:
        CONFIG_DIR.mkdir(parents=True, exist_ok=True)
        if not PROVIDERS_FILE.exists():
            PROVIDERS_FILE.write_text(default_config_text(), encoding="utf-8")
    except Exception:
        pass


def load_config():
    ensure_providers_file()
    try:
        cfg = json.loads(PROVIDERS_FILE.read_text(encoding="utf-8"))
        if not isinstance(cfg, dict) or not isinstance(cfg.get("providers"), dict):
            raise ValueError("bad config")
    except Exception:
        cfg = json.loads(default_config_text())
    for pname, p in cfg["providers"].items():
        if not isinstance(p, dict):
            cfg["providers"][pname] = dict(DEFAULT_CONFIG["providers"].get(pname, {}))
            p = cfg["providers"][pname]
        if pname in DEFAULT_CONFIG["providers"]:
            for k, v in DEFAULT_CONFIG["providers"][pname].items():
                p.setdefault(k, v)
        key = p.get("apiKey", "")
        if isinstance(key, str) and key.startswith("$"):
            p["apiKey"] = os.environ.get(key[1:], "")
        p["baseURL"] = (p.get("baseURL") or "").rstrip("/")
    return cfg


def check_ollama(base=API_URL):
    try:
        with urllib.request.urlopen(f"{base.rstrip('/')}/api/tags", timeout=1) as r:
            return r.status == 200
    except Exception:
        return False


def ensure_ollama(base=API_URL):
    if not shutil.which("ollama"):
        print("\033[93m[SuperCode] Ollama не найдена. Локальные модели недоступны.\033[0m")
        print("  Установите одной командой: curl -fsSL https://ollama.com/install.sh | sh")
        return False
    if check_ollama(base):
        return True
    print("\033[93m[SuperCode] Запуск службы Ollama в фоне...\033[0m")
    subprocess.Popen(["ollama", "serve"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
    for _ in range(15):
        time.sleep(1)
        if check_ollama(base):
            return True
    print("\033[91m[SuperCode] Не удалось запустить сервер Ollama.\033[0m")
    return False


def discover_ollama_models(base=API_URL, timeout=2):
    try:
        with urllib.request.urlopen(f"{base.rstrip('/')}/api/tags", timeout=timeout) as r:
            return [m["name"] for m in json.loads(r.read().decode()).get("models", [])]
    except Exception:
        return []


def provider_models(cfg, discover=True):
    """Единый список моделей: provider/model + метаданные."""
    out, seen = [], set()
    for pname, p in cfg.get("providers", {}).items():
        if p.get("enabled", True) is False:
            continue
        models = list(p.get("models") or [])
        if p.get("type") == "ollama" and discover:
            for m in discover_ollama_models(p.get("baseURL") or API_URL):
                if m not in models:
                    models.append(m)
        ready = bool(p.get("apiKey")) or bool(p.get("local")) or p.get("type") == "ollama"
        for model in models:
            ref = f"{pname}/{model}"
            if ref in seen:
                continue
            seen.add(ref)
            out.append({
                "ref": ref, "provider": pname, "model": model,
                "provider_name": p.get("name", pname),
                "free": bool(p.get("free")), "local": bool(p.get("local")),
                "ready": ready,
            })
    return out


def resolve_model(cfg, ref=None):
    ref = (ref or cfg.get("model") or "").strip()
    if "/" in ref:
        pname, model = ref.split("/", 1)
        if pname not in cfg.get("providers", {}):
            pname, model = "ollama", ref
    else:
        pname, model = "ollama", ref
    p = cfg["providers"].get(pname)
    if not p:
        raise RuntimeError(f"Провайдер '{pname}' не найден в {PROVIDERS_FILE}")
    return pname, p, model


def choose_start_model(cfg):
    models = provider_models(cfg)
    ref = cfg.get("model")
    if ref and any(m["ref"] == ref for m in models):
        return ref
    ready = [m for m in models if m["ready"]]
    if ready:
        return ready[0]["ref"]
    return models[0]["ref"] if models else ""


def search_hf_gguf(query):
    q = urllib.parse.quote(query.strip() or "qwen coder")
    url = f"https://huggingface.co/api/models?search={q}&filter=gguf&sort=downloads&direction=-1&limit=10"
    req = urllib.request.Request(url, headers={"User-Agent": "SuperCode/2.2"})
    with urllib.request.urlopen(req, timeout=10) as r:
        data = json.loads(r.read().decode())
    return [(m.get("id", ""), m.get("downloads", 0)) for m in data if isinstance(m, dict) and m.get("id")]


def _post_json(url, payload, headers=None, timeout=300):
    h = {"Content-Type": "application/json"}
    if headers:
        h.update({k: v for k, v in headers.items() if v})
    req = urllib.request.Request(url, data=json.dumps(payload).encode(), headers=h)
    try:
        with urllib.request.urlopen(req, timeout=timeout) as r:
            return json.loads(r.read().decode())
    except urllib.error.HTTPError as e:
        body = e.read().decode(errors="ignore")
        body = re.sub(r"\s+", " ", body).strip()[:400]
        raise RuntimeError(f"HTTP {e.code}: {body}")
    except urllib.error.URLError as e:
        raise RuntimeError(f"Сеть недоступна: {e.reason}")


def chat(cfg, ref, messages, gen_opts):
    """Единый вызов чата для любого провайдера."""
    pname, p, model = resolve_model(cfg, ref)
    typ = p.get("type", "openai")
    base = (p.get("baseURL") or "").rstrip("/")
    key = p.get("apiKey") or ""
    extra = dict(p.get("headers") or {})
    temp = float(gen_opts.get("temperature", 0.5))
    topp = float(gen_opts.get("top_p", 0.9))

    if typ == "ollama":
        opts = {"num_ctx": int(p.get("num_ctx", 8192)), "temperature": temp, "top_p": topp}
        if gen_opts.get("top_k") is not None:
            opts["top_k"] = int(gen_opts["top_k"])
        if gen_opts.get("repeat_penalty") is not None:
            opts["repeat_penalty"] = float(gen_opts["repeat_penalty"])
        payload = {"model": model, "messages": messages, "stream": False, "think": bool(gen_opts.get("show_thinking", False)), "options": opts}
        try:
            resp = _post_json(f"{base}/api/chat", payload, extra)
        except RuntimeError as e:
            if "think" in str(e):
                payload.pop("think", None)
                resp = _post_json(f"{base}/api/chat", payload, extra)
            else:
                raise
        msg = resp.get("message") or {}
        th = (msg.get("thinking") or "").strip()
        cnt = (msg.get("content") or "").strip()
        return (f"<think>\n{th}\n</think>\n{cnt}" if th else cnt).strip()

    if typ == "anthropic":
        sys_txt = "\n".join(m["content"] for m in messages if m.get("role") == "system")
        msgs = [{"role": m["role"], "content": m["content"]} for m in messages if m.get("role") in ("user", "assistant")]
        payload = {"model": model, "messages": msgs, "max_tokens": int(gen_opts.get("max_tokens", 4096)), "temperature": temp}
        if sys_txt:
            payload["system"] = sys_txt
        headers = {"x-api-key": key, "anthropic-version": "2023-06-01", **extra}
        resp = _post_json(f"{base}/v1/messages", payload, headers)
        return "".join(b.get("text", "") for b in resp.get("content", []) if b.get("type") == "text").strip()

    if typ == "google":
        sys_txt = "\n".join(m["content"] for m in messages if m.get("role") == "system")
        contents, system_roles = [], {"system"}
        for m in messages:
            if m.get("role") in system_roles:
                continue
            role = "model" if m.get("role") == "assistant" else "user"
            contents.append({"role": role, "parts": [{"text": m.get("content", "")}]})
        payload = {"contents": contents, "generationConfig": {"temperature": temp, "topP": topp}}
        if sys_txt:
            payload["systemInstruction"] = {"parts": [{"text": sys_txt}]}
        url = f"{base}/models/{urllib.parse.quote(model, safe='')}:generateContent?key={urllib.parse.quote(key)}"
        resp = _post_json(url, payload, extra)
        try:
            return "".join(part.get("text", "") for part in resp["candidates"][0]["content"]["parts"]).strip()
        except Exception:
            return ""

    payload = {"model": model, "messages": messages, "stream": False, "temperature": temp, "top_p": topp}
    if gen_opts.get("max_tokens"):
        payload["max_tokens"] = int(gen_opts["max_tokens"])
    headers = dict(extra)
    if key:
        headers["Authorization"] = f"Bearer {key}"
    resp = _post_json(f"{base}/chat/completions", payload, headers)
    try:
        msg = resp["choices"][0]["message"]
        th = (msg.get("reasoning_content") or "").strip()
        cnt = (msg.get("content") or "").strip()
        return (f"<think>\n{th}\n</think>\n{cnt}" if th and cnt else (cnt or th)).strip()
    except Exception:
        return ""


def chat_stream(cfg, ref, messages, gen_opts, on_chunk=None, abort_ev=None):
    """Потоковый вызов чата с выводом мыслей и слов в реальном времени."""
    pname, p, model = resolve_model(cfg, ref)
    typ = p.get("type", "openai")
    base = (p.get("baseURL") or "").rstrip("/")
    key = p.get("apiKey") or ""
    extra = dict(p.get("headers") or {})
    temp = float(gen_opts.get("temperature", 0.5))
    topp = float(gen_opts.get("top_p", 0.9))
    effort = gen_opts.get("reasoning_effort", "auto")
    show_th = bool(gen_opts.get("show_thinking", False))

    def _req(url, payload, headers):
        h = {"Content-Type": "application/json"}
        h.update({k: v for k, v in headers.items() if v})
        return urllib.request.Request(url, data=json.dumps(payload).encode(), headers=h)

    if typ == "ollama":
        opts = {"num_ctx": int(p.get("num_ctx", 8192)), "temperature": temp, "top_p": topp}
        if gen_opts.get("top_k") is not None:
            opts["top_k"] = int(gen_opts["top_k"])
        if gen_opts.get("repeat_penalty") is not None:
            opts["repeat_penalty"] = float(gen_opts["repeat_penalty"])
        think_val = effort if effort in ("low", "medium", "high") else show_th
        payload = {"model": model, "messages": messages, "stream": True, "think": think_val, "options": opts}
        try:
            resp = urllib.request.urlopen(_req(f"{base}/api/chat", payload, extra), timeout=300)
        except urllib.error.HTTPError as e:
            body = re.sub(r"\s+", " ", e.read().decode(errors="ignore")).strip()[:300]
            if "think" in body.lower():
                payload.pop("think", None)
                resp = urllib.request.urlopen(_req(f"{base}/api/chat", payload, extra), timeout=300)
            else:
                raise RuntimeError(f"HTTP {e.code}: {body}")
        th_buf, cnt_buf = [], []
        with resp:
            for raw in resp:
                if abort_ev and abort_ev.is_set():
                    break
                line = raw.decode(errors="ignore").strip()
                if not line:
                    continue
                d = json.loads(line)
                m = d.get("message") or {}
                if m.get("thinking"):
                    th_buf.append(m["thinking"])
                    if on_chunk:
                        on_chunk("think", m["thinking"])
                if m.get("content"):
                    cnt_buf.append(m["content"])
                    if on_chunk:
                        on_chunk("text", m["content"])
                if d.get("done"):
                    break
        th, cnt = "".join(th_buf).strip(), "".join(cnt_buf).strip()
        return (f"<think>\n{th}\n</think>\n{cnt}" if th else cnt).strip()

    if typ == "openai":
        payload = {"model": model, "messages": messages, "stream": True, "temperature": temp, "top_p": topp}
        if effort in ("low", "medium", "high"):
            payload["reasoning_effort"] = effort
        headers = dict(extra)
        if key:
            headers["Authorization"] = f"Bearer {key}"
        try:
            resp = urllib.request.urlopen(_req(f"{base}/chat/completions", payload, headers), timeout=300)
        except urllib.error.HTTPError as e:
            body = re.sub(r"\s+", " ", e.read().decode(errors="ignore")).strip()[:300]
            raise RuntimeError(f"HTTP {e.code}: {body}")
        th_buf, cnt_buf = [], []
        with resp:
            for raw in resp:
                if abort_ev and abort_ev.is_set():
                    break
                line = raw.decode(errors="ignore").strip()
                if not line.startswith("data: "):
                    continue
                data_s = line[6:].strip()
                if data_s == "[DONE]":
                    break
                d = json.loads(data_s)
                delta = ((d.get("choices") or [{}]).get("delta") or {})
                if delta.get("reasoning_content"):
                    th_buf.append(delta["reasoning_content"])
                    if on_chunk:
                        on_chunk("think", delta["reasoning_content"])
                if delta.get("content"):
                    cnt_buf.append(delta["content"])
                    if on_chunk:
                        on_chunk("text", delta["content"])
        th, cnt = "".join(th_buf).strip(), "".join(cnt_buf).strip()
        return (f"<think>\n{th}\n</think>\n{cnt}" if th and cnt else (cnt or th)).strip()

    full = chat(cfg, ref, messages, gen_opts)
    if on_chunk and full:
        on_chunk("text", full)
    return full


def parse_reply(reply, allow_run=True, allow_quoted_run=False):
    """Единый разбор ответа модели на видимый текст и действия //run //write //lastcontext."""
    thoughts = []
    def _grab_think(m):
        if m.group(1).strip():
            thoughts.append(m.group(1).strip())
        return ""
    reply = re.sub(r"<think>(.*?)</think>", _grab_think, reply, flags=re.S)
    vis, cmd, need_ctx, quoted_run = [], None, False, False
    write_file, write_buf, in_write, in_code = None, [], False, False
    for line in reply.splitlines():
        s = line.strip()
        if in_write:
            if s == "//end":
                in_write = False
            else:
                write_buf.append(line)
            continue
        if s.startswith("```"):
            in_code = not in_code
            vis.append(line)
            continue
        if allow_run and allow_quoted_run and cmd is None:
            if in_code:
                mq = re.match(r"^\s*//run\s+(.+)$", line)
                if mq:
                    cmd, quoted_run = mq.group(1).strip(), True
                    continue
            else:
                mi = re.search(r"`+\s*//run\s+([^`]+?)`+", line)
                if mi:
                    cmd, quoted_run = mi.group(1).strip(), True
                    vis.append(line)
                    continue
        if not in_code:
            mw = re.match(r"^\s*//write\s+(.+)$", line)
            if mw and write_file is None:
                write_file = mw.group(1).strip()
                in_write = True
                continue
            if re.match(r"^\s*//lastcon[a-z]*\s*$", line, re.I):
                need_ctx = True
                continue
            if allow_run and cmd is None:
                m = re.match(r"^\s*//run\s+(.+)$", line)
                if m:
                    cmd = m.group(1).strip()
                    continue
        vis.append(line)
    return {
        "visible": "\n".join(vis).strip(),
        "thinking": "\n\n".join(thoughts).strip(),
        "cmd": cmd,
        "quoted_run": quoted_run,
        "write": (write_file, write_buf) if write_file else None,
        "need_ctx": need_ctx,
    }


def headless_agent(cfg, ref, prompt, gen_opts, max_steps=6):
    msgs = init_msgs("BUILD")
    msgs.append({"role": "user", "content": prompt})
    for step in range(max_steps):
        _, _, model = resolve_model(cfg, ref)
        print(f"\033[90m[{step + 1}] {model}…\033[0m", file=sys.stderr)
        try:
            reply = chat(cfg, ref, msgs, gen_opts)
        except Exception as e:
            print(f"\033[91mОшибка: {e}\033[0m", file=sys.stderr)
            return 1
        msgs.append({"role": "assistant", "content": reply})
        a = parse_reply(reply, allow_run=True)
        if a["visible"]:
            print(a["visible"])
        if a["write"]:
            fp = Path(a["write"][0]).expanduser()
            try:
                fp.parent.mkdir(parents=True, exist_ok=True)
                fp.write_text("\n".join(a["write"][1]), encoding="utf-8")
                msg = f"Файл {fp} записан ({len(a['write'][1])} строк)."
                print(f"\033[32m✔ {msg}\033[0m", file=sys.stderr)
            except Exception as e:
                msg = f"Ошибка записи: {e}"
                print(f"\033[91m✘ {msg}\033[0m", file=sys.stderr)
            msgs.append({"role": "user", "content": msg})
            continue
        if a["need_ctx"]:
            msgs.append({"role": "user", "content": "Старый контекст недоступен в режиме run."})
            continue
        if a["cmd"]:
            cmd = a["cmd"]
            lvl = classify_cmd(cmd)
            if lvl == "DANGER":
                msg = "ЗАБЛОКИРОВАНО: опасная команда."
                print(f"\033[91m{msg}\033[0m", file=sys.stderr)
            else:
                print(f"\033[36m⚙ {cmd}\033[0m", file=sys.stderr)
                try:
                    r = subprocess.run(cmd, shell=True, text=True, capture_output=True, timeout=120)
                    out = (r.stdout + r.stderr).strip() or f"(код {r.returncode})"
                except Exception as e:
                    out = f"(ошибка: {e})"
                print(out)
                msg = f"Вывод `{cmd}`:\n{shrink_text(out, 900)}"
            msgs.append({"role": "user", "content": msg})
            continue
        break
    return 0


