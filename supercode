    def check_effort_support(self):
        p, model, pname = self.model_info()
        typ = p.get("type", "openai")
        m_low = model.lower()
        if typ == "ollama":
            try:
                base = (p.get("baseURL") or API_URL).rstrip("/")
                info = _post_json(f"{base}/api/show", {"name": model}, timeout=5)
                caps = [c.lower() for c in (info.get("capabilities") or [])]
                tpl = (info.get("template") or "").lower()
                if "thinking" in caps or "<think>" in tpl or any(k in m_low for k in ("gpt-oss", "qwen3", "deepseek-r1", "qwq", "r1")):
                    return True, ""
                return False, f"Модель '{model}' (Ollama) не поддерживает размышления и уровни усилий (capabilities: {caps or ['completion']})."
            except Exception as e:
                return False, f"Не удалось проверить модель в Ollama: {e}"
        supported_hints = ("o1", "o3", "o4", "gpt-5", "gpt-oss", "deepseek-r", "reasoner", "r1", "qwen3", "qwq", "claude-sonnet-4", "claude-opus-4", "claude-3-7", "gemini-2.5", "gemini-3")
        if any(k in m_low for k in supported_hints):
            return True, ""
        return False, f"Модель '{model}' ({pname}) не поддерживает настройку уровня усилий (Reasoning Effort)."

    def open_effort_selector(self):
        ok, err_msg = self.check_effort_support()
        if not ok:
            self.show_error_dialog("Уровень усилий не поддерживается", err_msg)
            return
        levels = [
            ("auto", "Авто (по умолчанию для модели)"),
            ("low", "Low — быстрые короткие рассуждения"),
            ("medium", "Medium — сбалансированная глубина"),
            ("high", "High — глубокий пошаговый анализ"),
        ]
        cur = self.gen_opts.get("reasoning_effort", "auto")
        sel = next((i for i, (k, _) in enumerate(levels) if k == cur), 0)
        while True:
            self.draw()
            my, mx = self.stdscr.getmaxyx()
            w, h = min(60, mx - 4), len(levels) + 6
            y0, x0 = max(1, (my - h) // 2), max(2, (mx - w) // 2)
            for dy in range(h):
                try:
                    self.stdscr.addstr(y0 + dy, x0, " " * w, curses.color_pair(9))
                except curses.error:
                    pass
            try:
                self.stdscr.addstr(y0 + 1, x0 + 2, f"Уровень усилий · {self.model_short()}"[:w - 4], curses.color_pair(9) | curses.A_BOLD)
                self.stdscr.addstr(y0 + 1, x0 + w - 5, "esc", curses.color_pair(9) | curses.A_DIM)
                for idx, (k, desc) in enumerate(levels):
                    mark = "● " if k == cur else "  "
                    attr = (curses.color_pair(6) | curses.A_BOLD) if idx == sel else curses.color_pair(9)
                    self.stdscr.addstr(y0 + 3 + idx, x0 + 2, f"{mark}{desc}"[:w - 4].ljust(w - 4), attr)
            except curses.error:
                pass
            self.stdscr.refresh()
            ch = self.get_key_blocking()
            if ch == "\x1b":
                return
            elif ch == curses.KEY_UP:
                sel = (sel - 1) % len(levels)
            elif ch == curses.KEY_DOWN:
                sel = (sel + 1) % len(levels)
            elif ch in ("\n", "\r", curses.KEY_ENTER):
                chosen = levels[sel][0]
                self.gen_opts["reasoning_effort"] = chosen
                if chosen != "auto":
                    self.show_thinking = True
                self.save_cfg()
                self.add_log(3, f"● Уровень усилий установлен: {chosen.upper()}")
                return

