    """Единый вызов чата для любого провайдера."""
    pname, p, model = resolve_model(cfg, ref)
    typ = p.get("type", "openai")
    base = (p.get("baseURL") or "").rstrip("/")
    key = p.get("apiKey") or ""
    extra = dict(p.get("headers") or {})
    temp = float(gen_opts.get("temperature", 0.5))
    topp = float(gen_opts.get("top_p", 0.9))

    if typ == "ollama":
        opts = {"num_ctx": int(gen_opts.get("num_ctx") or p.get("num_ctx", 8192)), "temperature": temp, "top_p": topp}
        if gen_opts.get("top_k") is not None:
            opts["top_k"] = int(gen_opts["top_k"])
        if gen_opts.get("repeat_penalty") is not None:
            opts["repeat_penalty"] = float(gen_opts["repeat_penalty"])
        payload = {"model": model, "messages": messages, "stream": False, "think": bool(gen_opts.get("show_thinking", False)), "keep_alive": ("20m" if gen_opts.get("keep_alive", True) else "5m"), "options": opts}
        try:
            resp = _post_json(f"{base}/api/chat", payload, extra)
        except RuntimeError as e:
            if "think" in str(e):
                payload.pop("think", None)
                resp = _post_json(f"{base}/api/chat", payload, extra)
            else:
                raise
        msg = resp.get("message") or {}
        th = (msg.get("thinking") or "").strip()
        cnt = (msg.get("content") or "").strip()
        return (f"<think>\n{th}\n</think>\n{cnt}" if th else cnt).strip()

    if typ == "anthropic":
        sys_txt = "\n".join(m["content"] for m in messages if m.get("role") == "system")
        msgs = [{"role": m["role"], "content": m["content"]} for m in messages if m.get("role") in ("user", "assistant")]
        payload = {"model": model, "messages": msgs, "max_tokens": int(gen_opts.get("max_tokens", 4096)), "temperature": temp}
        if sys_txt:
            payload["system"] = sys_txt
        headers = {"x-api-key": key, "anthropic-version": "2023-06-01", **extra}
        resp = _post_json(f"{base}/v1/messages", payload, headers)
        return "".join(b.get("text", "") for b in resp.get("content", []) if b.get("type") == "text").strip()

    if typ == "google":
        sys_txt = "\n".join(m["content"] for m in messages if m.get("role") == "system")
        contents, system_roles = [], {"system"}
        for m in messages:
            if m.get("role") in system_roles:
                continue
            role = "model" if m.get("role") == "assistant" else "user"
            contents.append({"role": role, "parts": [{"text": m.get("content", "")}]})
        payload = {"contents": contents, "generationConfig": {"temperature": temp, "topP": topp}}
        if sys_txt:
            payload["systemInstruction"] = {"parts": [{"text": sys_txt}]}
        url = f"{base}/models/{urllib.parse.quote(model, safe='')}:generateContent?key={urllib.parse.quote(key)}"
        resp = _post_json(url, payload, extra)
        try:
            return "".join(part.get("text", "") for part in resp["candidates"][0]["content"]["parts"]).strip()
        except Exception:
            return ""

    payload = {"model": model, "messages": messages, "stream": False, "temperature": temp, "top_p": topp}
    if gen_opts.get("max_tokens"):
        payload["max_tokens"] = int(gen_opts["max_tokens"])
    headers = dict(extra)
    if key:
        headers["Authorization"] = f"Bearer {key}"
    resp = _post_json(f"{base}/chat/completions", payload, headers)
    try:
        msg = resp["choices"][0]["message"]
        th = (msg.get("reasoning_content") or "").strip()
        cnt = (msg.get("content") or "").strip()
        return (f"<think>\n{th}\n</think>\n{cnt}" if th and cnt else (cnt or th)).strip()
    except Exception:
        return ""


def chat_stream(cfg, ref, messages, gen_opts, on_chunk=None, abort_ev=None):
    """Потоковый вызов чата с выводом мыслей и слов в реальном времени."""
    pname, p, model = resolve_model(cfg, ref)
    typ = p.get("type", "openai")
    base = (p.get("baseURL") or "").rstrip("/")
    key = p.get("apiKey") or ""
    extra = dict(p.get("headers") or {})
    temp = float(gen_opts.get("temperature", 0.5))
    topp = float(gen_opts.get("top_p", 0.9))
    effort = gen_opts.get("reasoning_effort", "auto")
    show_th = bool(gen_opts.get("show_thinking", False))

    def _req(url, payload, headers):
        h = {"Content-Type": "application/json"}
        h.update({k: v for k, v in headers.items() if v})
        return urllib.request.Request(url, data=json.dumps(payload).encode(), headers=h)

    if typ == "ollama":
        opts = {"num_ctx": int(gen_opts.get("num_ctx") or p.get("num_ctx", 8192)), "temperature": temp, "top_p": topp}
        if gen_opts.get("top_k") is not None:
            opts["top_k"] = int(gen_opts["top_k"])
        if gen_opts.get("repeat_penalty") is not None:
            opts["repeat_penalty"] = float(gen_opts["repeat_penalty"])
        think_val = effort if effort in ("low", "medium", "high") else show_th
        payload = {"model": model, "messages": messages, "stream": True, "think": think_val, "keep_alive": ("20m" if gen_opts.get("keep_alive", True) else "5m"), "options": opts}
        try:
            resp = urllib.request.urlopen(_req(f"{base}/api/chat", payload, extra), timeout=300)
        except urllib.error.HTTPError as e:
            body = re.sub(r"\s+", " ", e.read().decode(errors="ignore")).strip()[:300]
            if "think" in body.lower():
                payload.pop("think", None)
                resp = urllib.request.urlopen(_req(f"{base}/api/chat", payload, extra), timeout=300)
            else:
                raise RuntimeError(f"HTTP {e.code}: {body}")
        th_buf, cnt_buf = [], []
        with resp:
            for raw in resp:
                if abort_ev and abort_ev.is_set():
                    break
                line = raw.decode(errors="ignore").strip()
                if not line:
                    continue
                d = json.loads(line)
                m = d.get("message") or {}
                if m.get("thinking"):
                    th_buf.append(m["thinking"])
                    if on_chunk:
                        on_chunk("think", m["thinking"])
                if m.get("content"):
                    cnt_buf.append(m["content"])
                    if on_chunk:
                        on_chunk("text", m["content"])
                if d.get("done"):
                    break
        th, cnt = "".join(th_buf).strip(), "".join(cnt_buf).strip()
        return (f"<think>\n{th}\n</think>\n{cnt}" if th else cnt).strip()

    if typ == "openai":
        payload = {"model": model, "messages": messages, "stream": True, "temperature": temp, "top_p": topp}
        if effort in ("low", "medium", "high"):
            payload["reasoning_effort"] = effort
        headers = dict(extra)
        if key:
            headers["Authorization"] = f"Bearer {key}"
        try:
            resp = urllib.request.urlopen(_req(f"{base}/chat/completions", payload, headers), timeout=300)
        except urllib.error.HTTPError as e:
            body = re.sub(r"\s+", " ", e.read().decode(errors="ignore")).strip()[:300]
            raise RuntimeError(f"HTTP {e.code}: {body}")
        th_buf, cnt_buf = [], []
        with resp:
            for raw in resp:
                if abort_ev and abort_ev.is_set():
                    break
                line = raw.decode(errors="ignore").strip()
                if not line.startswith("data: "):
                    continue
                data_s = line[6:].strip()
                if data_s == "[DONE]":
                    break
                d = json.loads(data_s)
                delta = ((d.get("choices") or [{}]).get("delta") or {})
                if delta.get("reasoning_content"):
                    th_buf.append(delta["reasoning_content"])
                    if on_chunk:
                        on_chunk("think", delta["reasoning_content"])
                if delta.get("content"):
                    cnt_buf.append(delta["content"])
                    if on_chunk:
                        on_chunk("text", delta["content"])
        th, cnt = "".join(th_buf).strip(), "".join(cnt_buf).strip()
        return (f"<think>\n{th}\n</think>\n{cnt}" if th and cnt else (cnt or th)).strip()

    full = chat(cfg, ref, messages, gen_opts)
    if on_chunk and full:
        on_chunk("text", full)
    return full


def parse_reply(reply, allow_run=True, allow_quoted_run=False):
    """Единый разбор ответа модели на видимый текст и действия //run //write //lastcontext."""
    thoughts = []
    def _grab_think(m):
        if m.group(1).strip():
            thoughts.append(m.group(1).strip())
        return ""
    reply = re.sub(r"<think>(.*?)</think>", _grab_think, reply, flags=re.S)
    vis, cmd, need_ctx, quoted_run, search_q, netget_u = [], None, False, False, None, None
    write_file, write_buf, in_write, in_code = None, [], False, False
    for line in reply.splitlines():
        s = line.strip()
        if in_write:
            if s == "//end":
                in_write = False
            else:
                write_buf.append(line)
            continue
        if s.startswith("```"):
            in_code = not in_code
            vis.append(line)
            continue
        if allow_run and allow_quoted_run and cmd is None:
            if in_code:
                mq = re.match(r"^\s*//run\s+(.+)$", line)
                if mq:
                    cmd, quoted_run = mq.group(1).strip(), True
                    continue
            else:
                mi = re.search(r"`+\s*//run\s+([^`]+?)`+", line)
                if mi:
                    cmd, quoted_run = mi.group(1).strip(), True
                    vis.append(line)
                    continue
        if not in_code:
            mw = re.match(r"^\s*//write\s+(.+)$", line)
            if mw and write_file is None:
                write_file = mw.group(1).strip()
                in_write = True
                continue
            if re.match(r"^\s*//lastcon[a-z]*\s*$", line, re.I):
                need_ctx = True
                continue
            ms = re.match(r"^\s*//search\s+(.+)$", line, re.I)
            if ms and search_q is None:
                search_q = ms.group(1).strip()
                continue
            mn = re.match(r"^\s*//netget\s+(\S+)$", line, re.I)
            if mn and netget_u is None:
                netget_u = mn.group(1).strip()
                continue
            if allow_run and cmd is None:
                m = re.match(r"^\s*//run\s+(.+)$", line)
                if m:
                    cmd = m.group(1).strip()
                    continue
        vis.append(line)
    return {
        "visible": "\n".join(vis).strip(),
        "thinking": "\n\n".join(thoughts).strip(),
        "cmd": cmd,
        "quoted_run": quoted_run,
        "write": (write_file, write_buf) if write_file else None,
        "need_ctx": need_ctx, "search": search_q, "netget": netget_u,
    }


def headless_agent(cfg, ref, prompt, gen_opts, max_steps=6):
    msgs = init_msgs("BUILD")
    msgs.append({"role": "user", "content": prompt})
    for step in range(max_steps):
        _, _, model = resolve_model(cfg, ref)
        print(f"\033[90m[{step + 1}] {model}…\033[0m", file=sys.stderr)
        try:
            reply = chat(cfg, ref, msgs, gen_opts)
        except Exception as e:
            print(f"\033[91mОшибка: {e}\033[0m", file=sys.stderr)
            return 1
        msgs.append({"role": "assistant", "content": reply})
        a = parse_reply(reply, allow_run=True)
        if a["visible"]:
            print(a["visible"])
        if a["write"]:
            fp = Path(a["write"][0]).expanduser()
            try:
                fp.parent.mkdir(parents=True, exist_ok=True)
                fp.write_text("\n".join(a["write"][1]), encoding="utf-8")
                msg = f"Файл {fp} записан ({len(a['write'][1])} строк)."
                print(f"\033[32m✔ {msg}\033[0m", file=sys.stderr)
            except Exception as e:
                msg = f"Ошибка записи: {e}"
                print(f"\033[91m✘ {msg}\033[0m", file=sys.stderr)
            msgs.append({"role": "user", "content": msg})
            continue
        if a["need_ctx"]:
            msgs.append({"role": "user", "content": "Старый контекст недоступен в режиме run."})
            continue
        if a["cmd"]:
            cmd = a["cmd"]
            lvl = classify_cmd(cmd)
            if lvl == "DANGER":
                msg = "ЗАБЛОКИРОВАНО: опасная команда."
                print(f"\033[91m{msg}\033[0m", file=sys.stderr)
            else:
                print(f"\033[36m⚙ {cmd}\033[0m", file=sys.stderr)
                try:
                    r = subprocess.run(cmd, shell=True, text=True, capture_output=True, timeout=120)
                    out = (r.stdout + r.stderr).strip() or f"(код {r.returncode})"
                except Exception as e:
                    out = f"(ошибка: {e})"
                print(out)
                msg = f"Вывод `{cmd}`:\n{shrink_text(out, 900)}"
            msgs.append({"role": "user", "content": msg})
            continue
        break
    return 0


