            for dy in range(h):
                try:
                    self.stdscr.addstr(y0 + dy, x0, " " * w, curses.color_pair(9))
                except curses.error:
                    pass
            try:
                self.stdscr.addstr(y0 + 1, x0 + 2, f"✘ {title}"[:w - 4], curses.color_pair(4) | curses.A_BOLD)
                for idx, ln in enumerate(lines[:h - 5]):
                    self.stdscr.addstr(y0 + 3 + idx, x0 + 2, ln[:w - 4], curses.color_pair(9))
                btn = "[  OK  ]"
                self.stdscr.addstr(y0 + h - 2, x0 + max(2, (w - len(btn)) // 2), btn, curses.color_pair(6) | curses.A_BOLD)
            except curses.error:
